{
  "name": "deeplook-api",
  "version": "1.0.0",
  "private": true,
  "description": "DeepLook API - Fastify + Prisma + S3(MinIO)",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx src/seed.ts",
    "test:unit": "node --import ./tests/unit/setup.mjs --import tsx --test \"tests/unit/*.test.ts\"",
    "test:fuzz": "node --import ./tests/unit/setup.mjs --import tsx tests/fuzz/run.ts",
    "test:integration": "node tests/run.mjs",
    "test:images": "node tests/images.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/websocket": "^11.3.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@virustotal/yara-x": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "ldapts": "9.2.0",
    "postal-mime": "^4.2.0",
    "prisma": "7.10.1",
    "qrcode": "^1.5.4",
    "svg-captcha": "1.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0"
  }
}
