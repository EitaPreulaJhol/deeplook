// DeepLook - Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ANALYST
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EntryType {
  FILE
  URL
}

enum EntryStatus {
  PENDING
  IN_REVIEW
  COMPLETED
}

enum Verdict {
  UNKNOWN
  CLEAN
  SUSPICIOUS
  MALICIOUS
}

enum SandboxStatus {
  REQUESTED
  PROVISIONING
  RUNNING
  STOPPING
  STOPPED
  EXPIRED
  FAILED
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  displayName    String
  role           Role       @default(USER)
  status         UserStatus @default(ACTIVE)
  /// Preferencias de uso (pagina inicial, registros por pagina...). Ver src/lib/preferences.ts.
  preferences    Json       @default("{}")
  /// Ultima atividade (GET /api/auth/me) e a visita anterior a ela: base dos
  /// avisos "desde a sua ultima visita" da Pagina Inicial.
  lastSeenAt     DateTime?
  previousSeenAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sessions        Session[]
  entries         Entry[]          @relation("EntryOwner")
  /// Amostras sob responsabilidade deste analista (atribuicao).
  assignedEntries Entry[]          @relation("EntryAssignee")
  entryEvents     EntryEvent[]
  reports         Report[]         @relation("ReportAuthor")
  sandboxSessions SandboxSession[]
  createdKeys     ActivationKey[]  @relation("KeyCreator")
  usedKeys        ActivationKey[]  @relation("KeyUser")
  favorites       Favorite[]
  /// Caixa de entrada: notificacoes recebidas e as causadas por este usuario.
  notifications   Notification[]   @relation("NotificationRecipient")
  notified        Notification[]   @relation("NotificationActor")
  reportTemplates ReportTemplate[]
  reviewedReports Report[]         @relation("ReportReviewer")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ActivationKey {
  id        String    @id @default(cuid())
  code      String    @unique
  role      Role      @default(USER)
  maxUses   Int       @default(1)
  usesUsed  Int       @default(0)
  expiresAt DateTime?
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  createdById String
  createdBy   User   @relation("KeyCreator", fields: [createdById], references: [id])
  usedBy      User[] @relation("KeyUser")
}

model Entry {
  id              String      @id @default(cuid())
  ownerId         String
  owner           User        @relation("EntryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  type            EntryType
  title           String
  description     String?
  status          EntryStatus @default(PENDING)
  verdict         Verdict     @default(UNKNOWN)
  /// Quando a amostra entrou no status atual (idade na fila / prazo). Mantido por
  /// um trigger no Postgres a cada mudanca de status (migracao entry_status_changed_at).
  statusChangedAt DateTime    @default(now())

  /// Analista responsavel pela amostra (atribuicao); null = sem responsavel.
  assigneeId String?
  assignee   User?   @relation("EntryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Duplicata de outra amostra (a principal); herda o veredito dela.
  duplicateOfId String?
  duplicateOf   Entry?  @relation("EntryDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Entry[] @relation("EntryDuplicate")

  originalFilename String?
  storageKey       String?
  bucket           String?
  fileSize         Int?
  mimeType         String?
  sha256           String?
  /// Analise estatica do arquivo no envio (src/lib/static-analysis.ts): tipo real,
  /// entropia, strings e cabecalho PE. So leitura de bytes; null em URLs.
  staticInfo       Json?

  url       String?
  urlDomain String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports         Report[]
  tags            Tag[]
  sandboxSessions SandboxSession[]
  events          EntryEvent[]
  favorites       Favorite[]
  reportIocs      ReportIoc[]
  notifications   Notification[]

  @@index([ownerId])
  @@index([assigneeId])
  @@index([sha256])
  @@index([createdAt])
  /// Aba "Relacionadas": amostras do mesmo dominio.
  @@index([urlDomain])
  /// Fila "Atrasadas" e ordenacao por idade.
  @@index([status, statusChangedAt])
  @@index([duplicateOfId])
}

model Tag {
  id      String  @id @default(cuid())
  name    String  @unique
  entries Entry[]
}

model Report {
  id           String       @id @default(cuid())
  entryId      String
  entry        Entry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  analystId    String
  analyst      User         @relation("ReportAuthor", fields: [analystId], references: [id])
  summary      String
  findings     String?
  iocs         String?
  verdict      Verdict      @default(UNKNOWN)
  /// Rascunho -> (Em revisao ->) Publicado. Ver REPORT_REVIEW_REQUIRED.
  status       ReportStatus @default(DRAFT)
  /// Revisao (quatro olhos): quem aprovou/devolveu, quando e o comentario da devolucao.
  submittedAt  DateTime?
  reviewedById String?
  reviewedBy   User?        @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  /// Indicadores extraidos do campo `iocs` (so de relatorios publicados).
  extractedIocs ReportIoc[]

  @@index([entryId])
  @@index([status])
}

enum ReportStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

/// VM isolada (clone do template no Proxmox) usada para analisar uma amostra.
model SandboxSession {
  id        String @id @default(cuid())
  entryId   String
  entry     Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  analystId String
  analyst   User   @relation(fields: [analystId], references: [id], onDelete: Cascade)

  node      String
  vmid      Int?
  name      String
  status    SandboxStatus @default(REQUESTED)
  /// Etapa atual do provisionamento (texto curto mostrado na UI).
  phase     String?
  /// Volume do ISO gerado com a amostra (para limpar depois).
  isoVolume String?
  /// UPID da task do Proxmox em andamento (clone/start/upload).
  upid      String?
  ip        String?
  lastError String?

  expiresAt DateTime
  startedAt DateTime?
  stoppedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, expiresAt])
  @@index([entryId])
  @@index([analystId])
}

/// Tipos de evento do historico (auditoria) de uma amostra.
enum EntryEventType {
  CREATED
  STATUS_CHANGED
  VERDICT_CHANGED
  ASSIGNED
  REPORT_CREATED
  REPORT_PUBLISHED
  /// Relatorio enviado para revisao / aprovado / devolvido (detail = comentario).
  REPORT_SUBMITTED
  REPORT_APPROVED
  REPORT_RETURNED
  SANDBOX_OPENED
  SANDBOX_CLOSED
  SANDBOX_FAILED
  /// Atualizacao/comentario livre (texto puro no `detail`).
  COMMENT
  /// Marcada como duplicata (fromValue: situacao anterior em JSON; detail: id da principal).
  MARKED_DUPLICATE
  /// Deixou de ser duplicata (detail: id da principal anterior).
  UNMARKED_DUPLICATE
}

/// Linha do tempo da amostra: quem fez o que e quando (aba "Historico").
model EntryEvent {
  id        String         @id @default(cuid())
  entryId   String
  entry     Entry          @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /// Quem fez a acao; null = o sistema (ex.: expiracao do sandbox).
  actorId   String?
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      EntryEventType
  /// Valores legiveis "de -> para" (ex.: status, nome do responsavel).
  fromValue String?
  toValue   String?
  detail    String?
  createdAt DateTime       @default(now())

  @@index([entryId, createdAt])
}

enum FavoriteKind {
  VIEW
  ENTRY
}

/// Pasta "Favoritos" do Navegador do Sistema: visoes de lista salvas (URL com os
/// filtros) e amostras fixadas, por usuario.
model Favorite {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      FavoriteKind
  label     String
  /// VIEW: caminho relativo do proprio app (ex.: /history?status=PENDING).
  url       String?
  /// ENTRY: amostra fixada (some dos favoritos se a amostra for apagada).
  entryId   String?
  entry     Entry?       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  position  Int          @default(0)
  createdAt DateTime     @default(now())

  @@unique([userId, entryId])
  @@index([userId, position])
}

enum IocKind {
  IPV4
  DOMAIN
  EMAIL
  MD5
  SHA1
  SHA256
}

/// IOCs normalizados dos relatorios publicados (src/lib/iocs.ts): base do motivo
/// "IOCs em comum" na aba Relacionadas. Reindexado a cada criacao/edicao do relatorio.
model ReportIoc {
  id       String  @id @default(cuid())
  reportId String
  report   Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Copia do entryId do relatorio (agrupa por amostra sem join).
  entryId  String
  entry    Entry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  kind     IocKind
  value    String

  @@unique([reportId, kind, value])
  @@index([kind, value])
  @@index([entryId])
}

enum NotificationType {
  /// Amostra atribuida ao destinatario.
  ASSIGNED
  /// Amostra do destinatario concluida (detail = veredito).
  COMPLETED
  /// Destinatario mencionado numa atualizacao (detail = trecho).
  MENTION
  /// Atualizacao numa amostra do destinatario ou sob sua responsabilidade.
  COMMENT
  /// Relatorio do destinatario aprovado na revisao / devolvido (detail = comentario).
  REPORT_APPROVED
  REPORT_RETURNED
}

/// Caixa de entrada (sininho do masthead): criadas junto com os eventos do
/// historico, nunca para quem fez a acao (src/lib/notifications.ts).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  entryId   String
  entry     Entry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  detail    String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Modelos de relatorio (Templates do HPSM): preenchem o "Novo relatorio".
/// Analistas leem; o admin mantem a lista (aba Modelos da Administracao).
model ReportTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  summary     String
  findings    String?
  iocs        String?
  /// Veredito sugerido ao aplicar o modelo.
  verdict     Verdict  @default(UNKNOWN)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
