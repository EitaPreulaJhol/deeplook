/// Auditoria administrativa (aba Auditoria da Administracao): quem fez o que,
/// em quem e de onde. Nunca guarda senhas (src/lib/audit.ts).
model AuditEvent {
  id           String      @id @default(cuid())
  action       AuditAction
  actorId      String?
  actor        User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?       @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  /// Rotulo do alvo no momento (e-mail, codigo da chave, nome do modelo).
  targetLabel  String?
  detail       String?
  ip           String?
  createdAt    DateTime    @default(now())
  /// Encadeamento (lib/audit.ts): posicao na cadeia, hash do evento anterior e o proprio hash.
  /// Vazios so no historico anterior ao encadeamento, ate a API encadea-lo.
  seq          Int?        @unique
  prevHash     String?
  hash         String?
  /// Ids como estavam na gravacao, sem chave estrangeira: entram no hash e nao mudam se a
  /// conta for apagada (actorId e targetUserId viram nulos).
  actorRef     String?
  targetRef    String?

  @@index([createdAt])
  @@index([action, createdAt])
}

/// O que um token de API pode fazer (item 3.2). Cada escopo alcanca so as suas rotas
/// (src/lib/api-tokens.ts): SAMPLES = envio e consulta de amostras; STATUS = somente leitura
/// do status do sistema, para um monitor externo (so admin cria).
enum ApiTokenScope {
  SAMPLES
  STATUS
  /// Feed de indicadores (item 5.3): so o TAXII 2.1 e o feed MISP, para um TIP ou SIEM puxar.
  FEED
}

/// Token de API pessoal (Minha Conta > Tokens de API): so envio e consulta de
/// amostras (src/lib/api-tokens.ts), ou, com o escopo STATUS, so a leitura do status.
/// Guarda so o hash; o token aparece uma vez.
model ApiToken {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// Comeco do token ("dlk_xxxxxxxx"), para reconhecer qual e qual.
  prefix     String
  tokenHash  String        @unique
  scope      ApiTokenScope @default(SAMPLES)
  expiresAt  DateTime
  lastUsedAt DateTime?
  lastUsedIp String?
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())

  @@index([userId])
}

enum ReputationKind {
  HASH
  DOMAIN
  IP
}

enum ReputationStatus {
  PENDING
  FOUND
  NOT_FOUND
  ERROR
}

/// Reputacao externa da amostra (src/lib/reputation.ts): um resultado por servico.
/// So o indicador sai do servidor (SHA-256 ou dominio/IP), nunca o arquivo.
model ReputationResult {
  id        String           @id @default(cuid())
  entryId   String
  entry     Entry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /// virustotal, malwarebazaar, urlhaus, threatfox, abuseipdb
  service   String
  kind      ReputationKind
  indicator String
  status    ReputationStatus
  verdict   Verdict          @default(UNKNOWN)
  summary   String
  link      String?
  details   Json?
  checkedAt DateTime         @default(now())

  @@unique([entryId, service])
  /// Cache de 24 h: mesmo servico e indicador em outra amostra.
  @@index([service, indicator, checkedAt])
}

enum AvStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

/// Varredura do ClamAV (src/lib/clamav.ts): a mais recente de cada amostra.
model AntivirusScan {
  id        String    @id @default(cuid())
  entryId   String    @unique
  entry     Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  status    AvStatus
  /// Nome da assinatura quando infectado (ex.: Win.Test.EICAR_HDB-1).
  signature String?
  error     String?
  engine    String?
  dbVersion Int?
  dbDate    DateTime?
  scannedAt DateTime  @default(now())

  @@index([scannedAt])
}

/// Codigos de recuperacao do 2FA (uso unico; so o hash).
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, codeHash])
}

/// Passkey (WebAuthn) cadastrada pela propria pessoa em Minha Conta; serve so para ENTRAR (login
/// alternativo, com verificacao do usuario obrigatoria: vale por senha e segundo fator).
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ID da credencial (base64url), o que o navegador devolve ao entrar.
  credentialId String    @unique
  publicKey    Bytes
  /// Contador de assinaturas: um valor que nao sobe indica credencial clonada.
  counter      Int       @default(0)
  transports   String[]
  /// 'singleDevice' ou 'multiDevice' (sincronizada) e se esta com copia de seguranca.
  deviceType   String
  backedUp     Boolean   @default(false)
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// Desafio de uso unico do WebAuthn (cadastro ou entrada), valido por poucos minutos.
model PasskeyChallenge {
  id        String   @id @default(cuid())
  challenge String
  /// 'register' (com userId) ou 'login' (sem usuario: a credencial diz quem e).
  purpose   String
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Prioridade da amostra: P1 Critica, P2 Alta, P3 Media (padrao), P4 Baixa.
enum Priority {
  P1
  P2
  P3
  P4
}

/// Alertas de IOC (item 60): indicadores que a pessoa segue.
model IocWatch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      IocKind
  value     String
  createdAt DateTime @default(now())

  @@unique([userId, kind, value])
  @@index([kind, value])
}

/// Regras YARA (item 56): escritas pelos analistas, validadas e aplicadas pela
/// API com o YARA-X (src/lib/yara.ts) a cada arquivo enviado.
model YaraRule {
  id          String          @id @default(cuid())
  /// Nome do conjunto (unico); o arquivo pode ter varias regras.
  name        String          @unique
  description String?
  source      String
  enabled     Boolean         @default(true)
  /// Pacote de origem (rules/packs.json, item 143); null = regra da equipe.
  pack        String?
  /// Caminho no pacote: identifica a regra entre versoes (item 150).
  packFile    String?
  createdById String?
  createdBy   User?           @relation("YaraRuleAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?           @relation("YaraRuleEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  retroscans  YaraRetroscan[]

  @@unique([pack, packFile])
  @@index([pack])
}

enum YaraPackReleaseStatus {
  APPLIED
  HELD
  ROLLED_BACK
  DISMISSED
}

/// Atualizacao de um pacote de regras: aplicada ou retida para um admin (item 150).
model YaraPackRelease {
  id          String                @id @default(cuid())
  pack        String
  commit      String
  commitDate  DateTime
  status      YaraPackReleaseStatus
  /// Quantos e quais arquivos mudam.
  summary     Json
  /// Motivos de ter ficado retida.
  reasons     Json?
  /// Versao anterior do que mudou; so a ultima aplicada guarda.
  undo        Json?
  canRollback Boolean               @default(false)
  createdAt   DateTime              @default(now())
  appliedAt   DateTime?

  @@index([pack, createdAt])
}

enum YaraStatus {
  PENDING
  CLEAN
  MATCHED
  ERROR
}

/// Ultima varredura YARA da amostra (acertos em JSON: conjunto, regra, tags).
model YaraScan {
  id         String     @id @default(cuid())
  entryId    String     @unique
  entry      Entry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  status     YaraStatus
  matches    Json       @default("[]")
  /// Quantos conjuntos ativos foram aplicados.
  rulesCount Int        @default(0)
  error      String?
  scannedAt  DateTime   @default(now())
}

/// Visoes da equipe (item 62): visoes do Historico Global compartilhadas pelos
/// analistas (pasta "Visoes da equipe" do navegador, com contador).
model TeamView {
  id          String   @id @default(cuid())
  label       String
  /// Caminho relativo (/history?...): uma visao por endereco.
  url         String   @unique
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum KbCategory {
  MALWARE_FAMILY
  SCAM
  TECHNIQUE
  PROCEDURE
}

/// Base de conhecimento (item 63): artigos em Markdown; todos leem, analistas escrevem.
model KbArticle {
  id          String              @id @default(cuid())
  title       String              @unique
  summary     String
  category    KbCategory
  tags        String[]            @default([])
  body        String
  createdById String?
  createdBy   User?               @relation("KbAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?               @relation("KbEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  revisions   KbArticleRevision[]
  reports     Report[]            @relation("ReportKbArticles")

  @@index([category, updatedAt])
}

/// Versao anterior de um artigo (guardada a cada edicao; o artigo mostra quem e quando).
model KbArticleRevision {
  id        String    @id @default(cuid())
  articleId String
  article   KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editorId  String?
  editor    User?     @relation(fields: [editorId], references: [id], onDelete: SetNull)
  title     String
  summary   String
  body      String
  createdAt DateTime  @default(now())

  @@index([articleId, createdAt])
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

/// Casos (item 55): amostras da mesma campanha (so analistas). Sem relatorio
/// proprio e nunca vazio (routes/cases.ts).
model Case {
  id            String         @id @default(cuid())
  /// Numero sequencial exibido como CASO-0001.
  number        Int            @unique @default(autoincrement())
  title         String
  description   String?
  status        CaseStatus     @default(OPEN)
  assigneeId    String?
  assignee      User?          @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?          @relation("CaseAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  closedAt      DateTime?
  entries       CaseEntry[]
  events        CaseEvent[]
  broadcasts    Broadcast[]
  notifications Notification[]

  @@index([status, updatedAt])
  @@index([assigneeId, status])
}

/// Amostra num caso (uma amostra pode estar em varios).
model CaseEntry {
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  addedById String?
  addedBy   User?    @relation(fields: [addedById], references: [id], onDelete: SetNull)
  addedAt   DateTime @default(now())

  @@id([caseId, entryId])
  @@index([entryId])
}

enum CaseEventType {
  CREATED
  ENTRY_ADDED
  ENTRY_REMOVED
  STATUS_CHANGED
  ASSIGNED
  UPDATED
  COMMENT
}

/// Linha do tempo do caso (inclusoes, status, responsavel, comentarios).
model CaseEvent {
  id        String        @id @default(cuid())
  caseId    String
  case      Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      CaseEventType
  detail    String?
  fromValue String?
  toValue   String?
  entryId   String?
  entry     Entry?        @relation(fields: [entryId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@index([caseId, createdAt])
}

enum YaraRetroStatus {
  RUNNING
  DONE
  CANCELLED
  FAILED
}

/// Varredura retroativa de uma regra YARA nas amostras ja guardadas (item 67).
/// Uma por vez; progresso em scanned/total (lib/yara-retro.ts).
model YaraRetroscan {
  id          String             @id @default(cuid())
  ruleId      String?
  rule        YaraRule?          @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  /// Nome da regra no inicio (fica mesmo se a regra for excluida).
  ruleName    String
  status      YaraRetroStatus    @default(RUNNING)
  total       Int
  scanned     Int                @default(0)
  matched     Int                @default(0)
  /// Arquivos que nao puderam ser lidos ou varridos.
  failed      Int                @default(0)
  /// Arquivos acima do limite de tamanho da varredura retroativa.
  skipped     Int                @default(0)
  startedById String?
  startedBy   User?              @relation(fields: [startedById], references: [id], onDelete: SetNull)
  startedAt   DateTime           @default(now())
  finishedAt  DateTime?
  error       String?
  hits        YaraRetroscanHit[]

  @@index([startedAt])
}

/// Amostra que casou numa varredura retroativa.
model YaraRetroscanHit {
  retroscanId String
  retroscan   YaraRetroscan @relation(fields: [retroscanId], references: [id], onDelete: Cascade)
  entryId     String
  entry       Entry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /// Regras (identificadores) do conjunto que casaram.
  identifiers String[]
  createdAt   DateTime      @default(now())

  @@id([retroscanId, entryId])
}

/// Lista de permissoes (item 69): indicadores legitimos que nao ligam amostras,
/// nao disparam alertas e somem das sugestoes. IPV4 aceita faixa CIDR
/// (ex.: 10.0.0.0/8); DOMAIN vale tambem para os subdominios.
model AllowedIndicator {
  id          String   @id @default(cuid())
  kind        IocKind
  value       String
  reason      String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([kind, value])
}

enum BroadcastLevel {
  INFO
  WARNING
}

/// Aviso geral (item 88): mensagem dos analistas para todos numa faixa no topo,
/// ate vencer ou a pessoa dispensar. No maximo 3 ativos (routes/broadcasts.ts).
model Broadcast {
  id          String               @id @default(cuid())
  text        String
  level       BroadcastLevel       @default(INFO)
  caseId      String?
  case        Case?                @relation(fields: [caseId], references: [id], onDelete: SetNull)
  startsAt    DateTime             @default(now())
  /// "Encerrar" antecipa a validade para agora.
  expiresAt   DateTime
  createdById String?
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())
  dismissals  BroadcastDismissal[]

  @@index([expiresAt])
}

/// Quem dispensou qual aviso (some so para essa pessoa).
model BroadcastDismissal {
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([broadcastId, userId])
}

/// Dominio da empresa (item 92): cadastrado pelo admin; entra tambem na lista de
/// permissoes. Dominios parecidos com ele sao marcados (src/lib/lookalike.ts).
model CompanyDomain {
  id          String   @id @default(cuid())
  domain      String   @unique
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

enum LookalikeReason {
  TLD
  HOMOGLYPH
  TYPO
  KEYWORD
  SUBDOMAIN
}

/// Dominio parecido com um da empresa visto numa amostra (refeito a cada analise).
model LookalikeHit {
  id            String          @id @default(cuid())
  entryId       String
  entry         Entry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  domain        String
  companyDomain String
  reason        LookalikeReason
  detail        String?
  /// Onde apareceu: URL (link da amostra), SENDER, LINK (do e-mail), IOC (sugerido), REPORT.
  sources       String[]
  createdAt     DateTime        @default(now())

  @@unique([entryId, domain])
  @@index([domain])
}

enum BackupStatus {
  RUNNING
  READY
  FAILED
  EXPIRED
}

/// Backup em ZIP para baixar (item 81): dump do banco + arquivos do MinIO e um
/// manifesto. Um por vez; fica no proprio bucket (backups/<id>.zip) ate expirar.
model Backup {
  id             String       @id @default(cuid())
  status         BackupStatus @default(RUNNING)
  /// Com os arquivos das amostras (o ZIP passa a ter malware).
  includeSamples Boolean      @default(false)
  /// Com senha (item 116). A senha nao e guardada em lugar nenhum.
  encrypted      Boolean      @default(false)
  /// Gerado pelo agendamento (item 6.13), e nao por um admin na tela.
  scheduled      Boolean      @default(false)
  /// Etapa atual ("Exportando o banco...") e 0-100.
  step           String?
  progress       Int          @default(0)
  key            String?
  size           BigInt?
  /// Versao, data, contagens e SHA-256 de cada parte (o mesmo manifest.json do ZIP).
  manifest       Json?
  error          String?
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  finishedAt     DateTime?
  expiresAt      DateTime?

  @@index([status, createdAt])
}

/// Onde a senha e conferida (item 94).
enum AuthSource {
  LOCAL
  LDAP
}

/// Captura de rede do sandbox (plano pos-revisao, item 5.4): o sniffer do MikroTik CHR manda por
/// TZSP os pacotes da VM ao servico netcap, que grava o pcap; ao encerrar, o pcap vai para o MinIO
/// e o Suricata o le (ET Open).
enum NetworkCaptureStatus {
  CAPTURING
  STORED
  FAILED
}

enum IdsStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model NetworkCapture {
  id               String               @id @default(cuid())
  sessionId        String               @unique
  session          SandboxSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// MAC da VM (net0 do clone), o filtro do sniffer.
  mac              String
  status           NetworkCaptureStatus @default(CAPTURING)
  error            String?
  /// O pcap no bucket.
  storageKey       String?
  bytes            Int?
  packets          Int?
  /// Bateu no teto do netcap (NETCAP_MAX_MB): o fim ficou de fora.
  truncated        Boolean              @default(false)
  startedAt        DateTime             @default(now())
  stoppedAt        DateTime?
  /// Suricata: alertas, DNS, HTTP e TLS do pcap (lib/suricata.ts).
  idsStatus        IdsStatus?
  idsResult        Json?
  idsError         String?
  idsMs            Int?
  idsAttempts      Int                  @default(0)
  idsNextAttemptAt DateTime?
  idsQueuedAt      DateTime?
  idsStartedAt     DateTime?
  idsFinishedAt    DateTime?

  @@index([status])
  @@index([idsStatus, idsNextAttemptAt])
}

/// Analises dos servicos novos (plans/novas-analises): emulacao (emulate), APK (android) e
/// configuracao de familias (extract). Uma por amostra e tipo, com a mesma fila das outras
/// (lib/service-analysis.ts): em segundo plano, um por vez por tipo, com tentativas.
model ServiceAnalysis {
  id            String                @id @default(cuid())
  entryId       String
  entry         Entry                 @relation(fields: [entryId], references: [id], onDelete: Cascade)
  kind          ServiceKind
  status        ServiceAnalysisStatus @default(PENDING)
  /// O que foi pedido (ex.: shellcode e a arquitetura na emulacao).
  options       Json?
  /// O resumo que o servico devolveu (sem o campo ok).
  result        Json?
  /// Alertas montados aqui a partir do resultado ({ level, text }).
  alerts        Json?
  /// Dominios, IPs e URLs do resultado (IOCs sugeridos).
  iocs          String[]              @default([])
  error         String?
  version       String?
  ms            Int?
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now())
  createdAt     DateTime              @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  @@unique([entryId, kind])
  @@index([kind, status, nextAttemptAt])
}

enum ServiceKind {
  EMULATION
  ANDROID
  CONFIG
  DOTNET
  JAR
}

enum ServiceAnalysisStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Dump de memoria de um processo da amostra no sandbox (plans/novas-analises, item 3): MiniDump
/// completo tirado na VM pelo agente, guardado com gzip no MinIO e lido pelo servico extract
/// (regioes suspeitas, PEs fora de imagem, configuracao de familias). Os PEs achados viram amostras
/// filhas.
model SandboxMemoryDump {
  id          String           @id @default(cuid())
  sessionId   String
  session     SandboxSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pid         Int
  image       String?
  processGuid String?
  status      MemoryDumpStatus @default(CAPTURING)
  /// O dump (gzip) no bucket.
  storageKey  String?
  /// Tamanho do dump e do gzip, em bytes.
  size        BigInt?
  storedSize  BigInt?
  /// SHA-256 do gzip (conferido na transferencia).
  sha256      String?
  error       String?
  /// O que o extract achou, sem os bytes dos PEs (regioes, URLs, configuracoes).
  result      Json?
  /// Amostras filhas criadas com os PEs achados: [{ entryId, sha256, base }].
  children    Json?
  attempts    Int              @default(0)
  createdAt   DateTime         @default(now())
  storedAt    DateTime?
  finishedAt  DateTime?

  @@index([sessionId])
  @@index([status])
}

enum MemoryDumpStatus {
  CAPTURING
  STORED
  ANALYZING
  DONE
  FAILED
}

/// Amostra por minuto das metricas do Monitoramento (plans/monitoramento, item 5): VMs ativas,
/// fila por servico, concluidos e falhos no minuto, memoria e event loop da API, CPU e memoria do
/// no do Proxmox. Fica 7 dias (lib/retention.ts).
model MonitorSample {
  at    DateTime
  key   String
  value Float

  @@id([key, at])
  @@index([at])
}
