// DeepLook - Prisma schema

// Cliente gerado em src/generated/prisma (fora do git; `npx prisma generate`).
// CommonJS, como o resto da API. A URL do banco fica no prisma.config.ts.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ANALYST
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EntryType {
  FILE
  URL
}

enum EntryStatus {
  PENDING
  IN_REVIEW
  COMPLETED
}

enum Verdict {
  UNKNOWN
  CLEAN
  SUSPICIOUS
  MALICIOUS
}

enum SandboxStatus {
  REQUESTED
  PROVISIONING
  RUNNING
  STOPPING
  STOPPED
  EXPIRED
  FAILED
}

model User {
  id                     String     @id @default(cuid())
  email                  String     @unique
  passwordHash           String
  displayName            String
  role                   Role       @default(USER)
  status                 UserStatus @default(ACTIVE)
  /// Acesso por API: so um admin libera (aba Usuarios). Sem ele, nenhum token vale.
  apiAccess              Boolean    @default(false)
  /// Senha redefinida pelo admin: so entra depois de definir uma nova (item 48).
  mustChangePassword     Boolean    @default(false)
  /// Conta do AD/LDAP (item 94): sem senha local (a do passwordHash nunca vale),
  /// papel pelos grupos a cada login.
  authSource             AuthSource @default(LOCAL)
  ldapDn                 String?    @unique
  /// Ultima troca de senha: base da validade (PASSWORD_MAX_AGE_DAYS; admins nao expiram).
  passwordChangedAt      DateTime   @default(now())
  /// 2FA (TOTP, opcional): segredo cifrado (AES-GCM), o pendente da ativacao,
  /// quando foi ativado e o ultimo passo de 30 s aceito (nao repete codigo).
  twoFactorSecret        String?
  twoFactorPendingSecret String?
  twoFactorEnabledAt     DateTime?
  twoFactorLastStep      Int?
  /// Preferencias de uso (pagina inicial, registros por pagina...). Ver src/lib/preferences.ts.
  preferences            Json       @default("{}")
  /// Ultima atividade (GET /api/auth/me) e a visita anterior a ela: base dos
  /// avisos "desde a sua ultima visita" da Pagina Inicial.
  lastSeenAt             DateTime?
  previousSeenAt         DateTime?
  /// Ausente (item 72): o rodizio da atribuicao automatica pula a pessoa.
  away                   Boolean    @default(false)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  sessions          Session[]
  entries           Entry[]                 @relation("EntryOwner")
  /// Amostras sob responsabilidade deste analista (atribuicao).
  assignedEntries   Entry[]                 @relation("EntryAssignee")
  entryEvents       EntryEvent[]
  reports           Report[]                @relation("ReportAuthor")
  sandboxSessions   SandboxSession[]
  createdKeys       ActivationKey[]         @relation("KeyCreator")
  usedKeys          ActivationKey[]         @relation("KeyUser")
  favorites         Favorite[]
  /// Caixa de entrada: notificacoes recebidas e as causadas por este usuario.
  notifications     Notification[]          @relation("NotificationRecipient")
  notified          Notification[]          @relation("NotificationActor")
  reportTemplates   ReportTemplate[]
  reviewedReports   Report[]                @relation("ReportReviewer")
  /// Auditoria: acoes feitas por este usuario e as que o tiveram como alvo.
  auditActions      AuditEvent[]            @relation("AuditActor")
  auditTargets      AuditEvent[]            @relation("AuditTarget")
  /// Amostras que este usuario (admin) moveu para a lixeira.
  trashedEntries    Entry[]                 @relation("EntryDeletedBy")
  apiTokens         ApiToken[]
  recoveryCodes     TwoFactorRecoveryCode[]
  passkeys          Passkey[]
  iocWatches        IocWatch[]
  iocUrlLookups     IocUrlLookup[]
  yaraRules         YaraRule[]              @relation("YaraRuleAuthor")
  yaraRulesEdited   YaraRule[]              @relation("YaraRuleEditor")
  sigmaRules        SigmaRule[]             @relation("SigmaRuleAuthor")
  sigmaRulesEdited  SigmaRule[]             @relation("SigmaRuleEditor")
  teamViews         TeamView[]
  kbCreated         KbArticle[]             @relation("KbAuthor")
  kbUpdated         KbArticle[]             @relation("KbEditor")
  kbRevisions       KbArticleRevision[]
  reportRevisions   ReportRevision[]
  reportEvidence    ReportEvidence[]
  assignmentGroups  AssignmentGroupMember[]
  pageCaptures      PageCapture[]
  /// Analises do Ghidra que o usuario pediu (item 7.3).
  ghidraAnalyses    GhidraAnalysis[]
  triageRules       TriageRule[]
  casesAssigned     Case[]                  @relation("CaseAssignee")
  casesCreated      Case[]                  @relation("CaseAuthor")
  caseEntriesAdded  CaseEntry[]
  caseEvents        CaseEvent[]
  yaraRetroscans    YaraRetroscan[]
  allowedIndicators AllowedIndicator[]
  broadcasts        Broadcast[]
  broadcastsSeen    BroadcastDismissal[]
  companyDomains    CompanyDomain[]
  backups           Backup[]
}

model Session {
  /// SHA-256 do valor do cookie (sessionIdOf, src/lib/auth.ts); o cookie nunca vai para o banco.
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  /// Aba Sessoes da Minha Conta (item 61): de onde e quando foi usada por ultimo.
  userAgent  String?
  ip         String?
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model ActivationKey {
  id        String    @id @default(cuid())
  code      String    @unique
  role      Role      @default(USER)
  maxUses   Int       @default(1)
  usesUsed  Int       @default(0)
  expiresAt DateTime?
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  createdById String
  createdBy   User   @relation("KeyCreator", fields: [createdById], references: [id])
  usedBy      User[] @relation("KeyUser")
}

model Entry {
  id              String         @id @default(cuid())
  ownerId         String
  owner           User           @relation("EntryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  type            EntryType
  title           String
  description     String?
  status          EntryStatus    @default(PENDING)
  verdict         Verdict        @default(UNKNOWN)
  /// Prioridade (item 53): define o prazo de alerta/atraso (src/lib/sla.ts).
  priority        Priority       @default(P3)
  /// Dominios parecidos com os da empresa achados nela (item 92).
  lookalikeHits   LookalikeHit[]
  /// Resolucao para quem enviou (item 87): o que fazer, em texto curto e sem
  /// detalhes tecnicos. Escrita pelos analistas; as duplicatas herdam a da principal.
  resolution      String?
  /// Quando a amostra entrou no status atual (idade na fila / prazo). Mantido por
  /// um trigger no Postgres a cada mudanca de status (migracao entry_status_changed_at).
  statusChangedAt DateTime       @default(now())
  /// Escalonamento por prazo (item 73): ate onde ja avisou no status atual
  /// (src/lib/sla-escalation.ts). O trigger de status volta para null.
  slaStage        SlaStage?

  /// Analista responsavel pela amostra (atribuicao); null = sem responsavel.
  assigneeId String?
  assignee   User?   @relation("EntryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Duplicata de outra amostra (a principal); herda o veredito dela.
  duplicateOfId String?
  duplicateOf   Entry?  @relation("EntryDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Entry[] @relation("EntryDuplicate")

  originalFilename   String?
  storageKey         String?
  bucket             String?
  fileSize           Int?
  mimeType           String?
  sha256             String?
  /// Hash parecido (TLSH, item 71; 70 hex sem o "T1"). Vazio = nao calculavel
  /// (arquivo pequeno/simples demais ou acima de 32 MB); null = ainda nao calculado.
  tlsh               String?
  /// Analise de funcoes (capa e FLOSS, item 7.2).
  capaAnalysis       CapaAnalysis?
  officeAnalysis     OfficeAnalysis?
  /// Emulacao, APK e configuracao de familias (plans/novas-analises, itens 2, 4 e 6).
  serviceAnalyses    ServiceAnalysis[]
  /// QR code na imagem, no PDF ou no print da pagina (plano pos-revisao, item 2.2).
  qrScan             QrScan?
  /// Analise com o Ghidra, sob demanda (item 7.3).
  ghidraAnalysis     GhidraAnalysis?
  /// Desempacotar e extrair (item 7.8).
  unpackJob          UnpackJob?
  /// imphash do PE (item 7.1), so quando distingue: fora do .NET e com 10+ funcoes importadas
  /// (tabela minima de empacotador e o _CorExeMain do .NET ligariam amostras sem relacao).
  imphash            String?
  /// MD5 do Rich header decodificado (item 7.1), como o pefile; so binarios do Visual Studio.
  richHash           String?
  /// Analise estatica do arquivo no envio (src/lib/static-analysis.ts): tipo real,
  /// entropia, strings e cabecalho PE. So leitura de bytes; null em URLs.
  staticInfo         Json?
  /// E-mail (.eml) lido no envio (src/lib/eml.ts): cabecalhos, autenticacao,
  /// caminho, links e corpo em texto. Cada anexo vira uma amostra filha.
  emailInfo          Json?
  /// Anexo de um e-mail enviado (amostra pai = o .eml).
  parentEntryId      String?
  parentEntry        Entry?            @relation("EntryAttachments", fields: [parentEntryId], references: [id], onDelete: SetNull)
  attachmentsOf      Entry[]           @relation("EntryAttachments")
  /// Arquivo apagado do armazenamento pela retencao (RETENTION_DAYS); ficha,
  /// relatorios, IOCs e hash continuam (src/lib/retention.ts).
  filePurgedAt       DateTime?
  /// Conferencia do SHA-256 do arquivo guardado (item 4.2): quando o objeto foi lido por inteiro
  /// e comparado com `sha256` (no download ou no job de scrub) e, se nao bateu ou o objeto sumiu,
  /// quando foi detectado. Voltando a bater, `integrityFailedAt` limpa (src/lib/integrity.ts).
  integrityCheckedAt DateTime?
  integrityFailedAt  DateTime?

  url       String?
  urlDomain String?
  /// SHA-256 do link normalizado (item 165): ficha do indicador de URL, sem o link no endereco.
  urlKey    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Lixeira (admin): some de todas as telas ate ser restaurada ou excluida de
  /// vez. O filtro e automatico nas consultas de Entry (src/lib/prisma.ts).
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("EntryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  reports         Report[]
  tags            Tag[]
  sandboxSessions SandboxSession[]
  events          EntryEvent[]
  favorites       Favorite[]
  reportIocs      ReportIoc[]
  notifications   Notification[]
  reputation      ReputationResult[]
  antivirus       AntivirusScan?
  yara            YaraScan?
  caseLinks       CaseEntry[]
  caseEvents      CaseEvent[]
  yaraRetroHits   YaraRetroscanHit[]
  pageCaptures    PageCapture[]

  @@index([ownerId])
  @@index([assigneeId])
  @@index([sha256])
  @@index([createdAt])
  /// Aba "Relacionadas": amostras do mesmo dominio.
  @@index([urlDomain])
  @@index([urlKey])
  @@index([imphash])
  @@index([richHash])
  /// Fila "Atrasadas" e ordenacao por idade.
  @@index([status, statusChangedAt])
  @@index([priority, status, statusChangedAt])
  @@index([duplicateOfId])
  @@index([deletedAt])
}

model Tag {
  id      String  @id @default(cuid())
  name    String  @unique
  entries Entry[]
}

/// Grupo de analistas da atribuicao automatica (item 72), ex.: Phishing, Malware.
model AssignmentGroup {
  id        String                  @id @default(cuid())
  name      String                  @unique
  createdAt DateTime                @default(now())
  members   AssignmentGroupMember[]
  rules     AssignmentRule[]
}

/// Membro de um grupo; o rodizio escolhe quem recebeu ha mais tempo.
model AssignmentGroupMember {
  groupId        String
  group          AssignmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ultima amostra recebida por este grupo (null = nunca: vem primeiro).
  lastAssignedAt DateTime?

  @@id([groupId, userId])
}

/// Regra: amostra nova do tipo / com a tag / da prioridade -> grupo. Campos
/// vazios valem para qualquer valor; a primeira regra ativa que casar vale.
model AssignmentRule {
  id        String          @id @default(cuid())
  position  Int
  groupId   String
  group     AssignmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entryType EntryType?
  tag       String?
  priority  Priority?
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@index([position])
}

model Report {
  id               String       @id @default(cuid())
  entryId          String
  entry            Entry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  analystId        String
  analyst          User         @relation("ReportAuthor", fields: [analystId], references: [id])
  summary          String
  findings         String?
  iocs             String?
  verdict          Verdict      @default(UNKNOWN)
  /// Tecnicas MITRE ATT&CK (ex.: T1566.001), validadas na lista embutida (src/lib/attack.ts).
  attackTechniques String[]     @default([])
  /// Rascunho -> (Em revisao ->) Publicado. Ver REPORT_REVIEW_REQUIRED.
  status           ReportStatus @default(DRAFT)
  /// Revisao (quatro olhos): quem aprovou/devolveu, quando e o comentario da devolucao.
  submittedAt      DateTime?
  reviewedById     String?
  reviewedBy       User?        @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  /// Artigos da base de conhecimento citados (item 63).
  kbArticles    KbArticle[]      @relation("ReportKbArticles")
  /// Indicadores extraidos do campo `iocs` (so de relatorios publicados).
  extractedIocs ReportIoc[]
  /// Versoes anteriores (item 75), uma por edicao do conteudo.
  revisions     ReportRevision[]
  /// Imagens de evidencia (item 76).
  evidence      ReportEvidence[]

  @@index([entryId])
  @@index([status])
  @@index([attackTechniques], type: Gin)
}

/// Versao anterior de um relatorio (item 75): guardada a cada edicao do conteudo.
/// A versao N+1 e de quem fez a edicao (`editor`) em `createdAt`; a 1a e do autor.
model ReportRevision {
  id               String       @id @default(cuid())
  reportId         String
  report           Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Quem fez a edicao que substituiu esta versao.
  editorId         String?
  editor           User?        @relation(fields: [editorId], references: [id], onDelete: SetNull)
  summary          String
  findings         String?
  iocs             String?
  verdict          Verdict
  attackTechniques String[]     @default([])
  /// Situacao do relatorio enquanto esta versao valia.
  status           ReportStatus
  /// Quando foi substituida.
  createdAt        DateTime     @default(now())

  @@index([reportId, createdAt])
}

/// Imagem de evidencia do relatorio (item 76): PNG/JPEG/WebP validada pelo tipo
/// real e sem metadados (src/lib/evidence-image.ts), guardada no MinIO.
model ReportEvidence {
  id           String   @id @default(cuid())
  reportId     String
  report       Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  /// Chave no bucket S3_BUCKET (evidence/<relatorio>/<uuid>.<ext>).
  storageKey   String
  mimeType     String
  width        Int
  height       Int
  size         Int
  caption      String?
  createdAt    DateTime @default(now())

  @@index([reportId, createdAt])
}

enum ReportStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

/// VM isolada (clone do template no Proxmox) usada para analisar uma amostra.
model SandboxSession {
  id        String @id @default(cuid())
  entryId   String
  entry     Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  analystId String
  analyst   User   @relation(fields: [analystId], references: [id], onDelete: Cascade)

  node          String
  vmid          Int?
  name          String
  status        SandboxStatus         @default(REQUESTED)
  /// Etapa atual do provisionamento (texto curto mostrado na UI).
  phase         String?
  /// Volume do ISO gerado com a amostra (para limpar depois).
  isoVolume     String?
  /// UPID da task do Proxmox em andamento (clone/start/upload).
  upid          String?
  ip            String?
  lastError     String?
  /// Por que a coleta de processos nao funciona (agente ausente, sem permissao); revisao 3.7.
  artifactsNote String?
  artifacts     SandboxArtifact[]
  /// Eventos do Sysmon, lidos aos poucos (plans/sandbox-execucoes, fase 2).
  sysmonEvents  SandboxSysmonEvent[]
  /// Deteccoes das regras Sigma (plans/novas-analises, item 1).
  sigmaHits     SandboxSigmaHit[]
  /// Dumps de memoria dos processos da amostra (plans/novas-analises, item 3).
  memoryDumps   SandboxMemoryDump[]
  /// O analista pediu a captura da memoria ao abrir (depois da execucao automatica).
  memoryDump    Boolean               @default(false)
  /// Quando capturar (a execucao automatica mais SANDBOX_MEMDUMP_DELAY_S); null = ainda nao.
  memoryDumpAt  DateTime?
  /// Captura de rede pelo MikroTik (plano pos-revisao, item 5.4).
  capture       NetworkCapture?
  /// O analista desligou a captura de rede ao abrir (plans/ajustes-usabilidade, item 5).
  captureOff    Boolean               @default(false)
  /// Execucao automatica da amostra (pedida ao abrir): depois do boot e do Sysmon, na sessao do
  /// usuario logado. Null = nao pedida.
  autoRun       SandboxAutoRunStatus?
  autoRunAt     DateTime?
  /// Em que conta rodou (DOMINIO\usuario, ou SYSTEM sem usuario logado).
  autoRunUser   String?
  /// O Sysmon estava no ar quando a amostra rodou.
  autoRunSysmon Boolean?
  autoRunError  String?

  expiresAt DateTime
  startedAt DateTime?
  stoppedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, expiresAt])
  @@index([entryId])
  @@index([analystId])
}

/// Execucao automatica da amostra no ambiente isolado.
enum SandboxAutoRunStatus {
  /// Esperando o agente da VM e o Sysmon.
  PENDING
  RUNNING
  DONE
  FAILED
}

enum SandboxArtifactKind {
  SCREENSHOT
  PROCESSES
  /// Situacao da leitura do Sysmon (plano pos-revisao, item 5.3; os eventos ficam em
  /// SandboxSysmonEvent). Sessoes antigas guardam aqui o resumo inteiro.
  SYSMON
}

/// Artefatos do sandbox (revisao de novembro, 3.7), colhidos enquanto o ambiente roda: o print da
/// tela (no MinIO) e a lista de processos que o agente do guest devolve.
model SandboxArtifact {
  id         String              @id @default(cuid())
  sessionId  String
  session    SandboxSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind       SandboxArtifactKind
  /// Print da tela (SCREENSHOT): chave no bucket.
  storageKey String?
  /// Processos (PROCESSES): [{ pid, ppid, name, cmd }].
  processes  Json?
  /// Sysmon (SYSMON): processos, rede, arquivos, registro e DNS desde o inicio (lib/sysmon.ts).
  sysmon     Json?
  createdAt  DateTime            @default(now())

  @@index([sessionId, createdAt])
}

/// Eventos do Sysmon de um ambiente (plans/sandbox-execucoes, fase 2): cada coleta le so os novos,
/// a partir do ultimo guardado, entao o comportamento tardio da amostra nao cai fora do teto de uma
/// leitura. A hora e a do relogio da VM; a diferenca para a da API fica na situacao (SYSMON).
model SandboxSysmonEvent {
  id           String         @id @default(cuid())
  sessionId    String
  session      SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// EventRecordID do log: com a hora, identifica o evento (reler a mesma janela nao duplica).
  recordId     BigInt
  /// 1 processo, 3 rede, 11 arquivo, 12-14 registro, 22 DNS.
  eventId      Int
  time         DateTime
  image        String?
  processGuid  String?
  /// ParentProcessGuid (so no evento 1): monta a arvore de processos da amostra.
  parentGuid   String?
  /// Os campos do evento (EventData), cada um cortado.
  data         Json
  /// Ja passou pelas regras Sigma (plans/novas-analises, item 1).
  sigmaChecked Boolean        @default(false)
  // Indice de trigramas em ("data"::text), da busca no sandbox (plans/caca-e-formatos, item 2), criado
  // na migracao 20270115000000_sandbox_hunt_trgm: o Prisma nao representa indice de expressao (fica
  // fora daqui, e o `prisma migrate diff` o ignora).

  @@unique([sessionId, recordId, time])
  @@index([sessionId, time])
  @@index([sessionId, processGuid])
  @@index([sessionId, sigmaChecked])
}

/// Regra Sigma da equipe (plans/caca-e-formatos, item 1): o YAML, validado pelo mesmo compilador
/// das vendorizadas. Nas deteccoes (SandboxSigmaHit.ruleId) ela e "team:<id>"; o nome e o title do
/// YAML. evaluatedAt: quando terminou a avaliacao sobre os eventos ja guardados (null = na fila).
model SigmaRule {
  id          String    @id @default(cuid())
  name        String    @unique
  source      String
  enabled     Boolean   @default(true)
  evaluatedAt DateTime?
  createdById String?
  createdBy   User?     @relation("SigmaRuleAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?     @relation("SigmaRuleEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Deteccao de uma regra Sigma nos eventos do Sysmon de um ambiente (plans/novas-analises, item 1):
/// uma linha por regra e processo, com quantas vezes casou e o primeiro evento.
model SandboxSigmaHit {
  id          String         @id @default(cuid())
  sessionId   String
  session     SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ruleId      String
  title       String
  /// informational, low, medium, high, critical.
  level       String
  /// Tecnicas ATT&CK das tags da regra.
  techniques  String[]       @default([])
  /// Processo do evento (ProcessGuid; SourceProcessGuid no acesso e na thread remota); "" sem ele.
  processGuid String         @default("")
  image       String?
  eventId     Int
  /// O primeiro evento que casou (os campos), para a tela.
  event       Json
  count       Int            @default(1)
  firstAt     DateTime
  lastAt      DateTime
  createdAt   DateTime       @default(now())

  @@unique([sessionId, ruleId, processGuid])
  @@index([sessionId, level])
  @@index([ruleId])
}

/// Tipos de evento do historico (auditoria) de uma amostra.
enum EntryEventType {
  CREATED
  STATUS_CHANGED
  VERDICT_CHANGED
  ASSIGNED
  REPORT_CREATED
  REPORT_PUBLISHED
  /// Relatorio enviado para revisao / aprovado / devolvido (detail = comentario).
  REPORT_SUBMITTED
  REPORT_APPROVED
  REPORT_RETURNED
  SANDBOX_OPENED
  SANDBOX_CLOSED
  SANDBOX_FAILED
  /// A amostra rodou sozinha no ambiente (execucao automatica pedida ao abrir).
  SANDBOX_AUTORUN
  /// Atualizacao/comentario livre (texto puro no `detail`).
  COMMENT
  /// Marcada como duplicata (fromValue: situacao anterior em JSON; detail: id da principal).
  MARKED_DUPLICATE
  /// Deixou de ser duplicata (detail: id da principal anterior).
  UNMARKED_DUPLICATE
  /// Prioridade mudou (fromValue/toValue: P1..P4).
  PRIORITY_CHANGED
  /// Arquivo expurgado pela retencao (detail: politica aplicada).
  FILE_PURGED
  /// Movida para a lixeira / restaurada (admin).
  TRASHED
  RESTORED
  /// Incluida num caso / retirada dele (detail: codigo do caso, ex.: CASO-0007).
  CASE_ADDED
  CASE_REMOVED
  /// Prazo em alerta / atrasada (item 73; fromValue = prioridade, detail = horas do prazo).
  SLA_WARN
  SLA_LATE
  /// Pagina do link capturada (item 80; toValue = HTTP, detail = redirecionamentos).
  PAGE_CAPTURED
  /// Arquivos extraidos de uma imagem de disco como amostras filhas (item 84; detail = quantos).
  FILES_EXTRACTED
  /// Regra de triagem aplicada (item 86; toValue = nome da regra, detail = o que mudou).
  TRIAGE_RULE
  /// Resolucao para quem enviou escrita/alterada (item 87; toValue = texto, null = removida).
  RESOLUTION_SET
}

/// Condicao de uma regra de triagem (item 86).
enum TriageCondition {
  DETECTED_TYPE
  YARA
  ANTIVIRUS
  DOMAIN
  SENDER
  MACRO
  DISGUISED
  SCRIPT_RISK
  DOCUMENT_RISK
  LNK
  /// Dominio parecido com o da empresa (item 124).
  LOOKALIKE
  /// Item 7.4: capacidade do capa, tecnica ATT&CK do capa, assinatura que nao confere,
  /// empacotador, alerta do PE e indicador numa string que so o FLOSS ve.
  CAPA_CAPABILITY
  ATTACK_TECHNIQUE
  SIGNATURE_INVALID
  PACKED
  PE_ALERT
  HIDDEN_IOC
  /// Item 7.9: o que o Detect It Easy reconheceu (compilador, empacotador, protetor...).
  DIE_DETECTION
}

/// Regra de triagem (item 86): quando a analise achar X, incluir tags e subir a
/// prioridade. Todas as regras ativas que casarem valem (src/lib/triage-rules.ts).
model TriageRule {
  id          String          @id @default(cuid())
  name        String
  condition   TriageCondition
  /// Tipo real, regra YARA, assinatura, dominio ou remetente (conforme a condicao).
  value       String?
  tags        String[]        @default([])
  priority    Priority?
  enabled     Boolean         @default(true)
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
}

enum CapaStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Analise de funcoes (item 7.2): capa e FLOSS no servico capa, em segundo plano, um por vez.
/// Uma por amostra (a mais recente); executaveis do Windows e do Linux.
model CapaAnalysis {
  id            String     @id @default(cuid())
  entryId       String     @unique
  entry         Entry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  status        CapaStatus @default(PENDING)
  /// Resumo do capa (apps/capa/server.py): regras com namespace, ATT&CK, MBC e enderecos.
  capa          Json?
  /// Strings do FLOSS: montadas na pilha, "apertadas" e decifradas, com a funcao.
  floss         Json?
  /// Tecnicas ATT&CK das regras do capa (sugestao no relatorio).
  attack        String[]
  /// Indicadores nas strings do FLOSS: so sugestao, como os da analise estatica.
  iocCandidates Json?
  capaError     String?
  flossError    String?
  /// Falha da analise inteira (servico fora, arquivo indisponivel, recusado).
  error         String?
  /// { capa, floss, rules } que fizeram a analise.
  versions      Json?
  ms            Int?
  attempts      Int        @default(0)
  nextAttemptAt DateTime   @default(now())
  createdAt     DateTime   @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([status, nextAttemptAt])
}

enum OfficeStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Office e PDF mais fundo (item 7.14; revisao de novembro, 3.2): o oletools no servico oletools,
/// em segundo plano, um por vez. Uma por amostra; documentos OLE, OOXML e RTF.
model OfficeAnalysis {
  id            String       @id @default(cuid())
  entryId       String       @unique
  entry         Entry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  status        OfficeStatus @default(PENDING)
  /// O que o servico devolveu (apps/oletools/analyze.py): vba, dde, oleid, rtf.
  result        Json?
  /// Alertas montados aqui a partir do resultado ({ level, text }).
  alerts        Json?
  error         String?
  version       String?
  ms            Int?
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  createdAt     DateTime     @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([status, nextAttemptAt])
}

enum QrStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// QR code em imagens, PDFs e no print da pagina (plano pos-revisao, item 2.2): lido no servico
/// oletools (POST /qr), em segundo plano, um por vez. Uma por amostra (a leitura mais recente).
model QrScan {
  id            String    @id @default(cuid())
  entryId       String    @unique
  entry         Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  status        QrStatus  @default(PENDING)
  /// O que foi lido: [{ text, truncated, source (image, pdf, screenshot), page, url }].
  codes         Json?
  /// Paginas do PDF (null numa imagem).
  pages         Int?
  error         String?
  ms            Int?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([status, nextAttemptAt])
}

enum GhidraStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Analise com o Ghidra (item 7.3): sob demanda (analistas pedem), no servico ghidra, um por vez.
/// Uma por amostra (a mais recente).
model GhidraAnalysis {
  id                String           @id @default(cuid())
  entryId           String           @unique
  entry             Entry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  requestedById     String?
  requestedBy       User?            @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  status            GhidraStatus     @default(PENDING)
  /// Resumo (apps/ghidra/scripts/ExportDeepLook.java): programa, maiores funcoes, quem chama APIs
  /// sensiveis e o pseudo-C dessas funcoes e do ponto de entrada.
  summary           Json?
  /// Projeto .gzf no MinIO, sob samples/ (tem os bytes da amostra: o backup sem amostras o deixa
  /// de fora, e a retencao e a lixeira o apagam junto com o arquivo).
  gzfKey            String?
  gzfSize           Int?
  gzfError          String?
  /// Pseudo-C de todas as funcoes (plans/ghidra-pseudo-c): um texto so no MinIO, FORA de samples/
  /// (e derivado, como o resumo: fica depois do expurgo da retencao e entra no backup sem
  /// amostras), e o indice em GhidraFunction com o deslocamento de cada funcao nele.
  pseudoKey         String?
  pseudoSize        Int?
  pseudoError       String?
  /// Funcoes do programa (as da lista podem ser menos: teto de 20 000) e se o prazo ou o teto do
  /// servico deixaram funcoes sem codigo.
  pseudoTotal       Int?
  pseudoDeadlineHit Boolean          @default(false)
  pseudoCapHit      Boolean          @default(false)
  functions         GhidraFunction[]
  error             String?
  /// Versao do Ghidra que fez a analise.
  version           String?
  ms                Int?
  attempts          Int              @default(0)
  nextAttemptAt     DateTime         @default(now())
  createdAt         DateTime         @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?

  @@index([status, nextAttemptAt])
}

/// Uma funcao do pseudo-C completo do Ghidra (plans/ghidra-pseudo-c). O codigo fica no texto do
/// MinIO (GhidraAnalysis.pseudoKey), lido por Range com cOffset e cLength (bytes UTF-8).
model GhidraFunction {
  id           String         @id @default(cuid())
  analysisId   String
  analysis     GhidraAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  /// Posicao na ordem de prioridade do servico (0 = a primeira: as do resumo, as que chamam APIs
  /// sensiveis, as demais por tamanho, as de biblioteca por ultimo).
  rank         Int
  entry        String
  name         String
  size         Int
  complexity   Int
  isEntryPoint Boolean
  /// Reconhecida pelo FunctionID (CRT, bibliotecas do Visual Studio).
  library      Boolean
  sensitive    String[]
  apis         String[]
  /// Enderecos de quem a chama e de quem ela chama (funcoes internas, ate 50 de cada), e os totais.
  callers      String[]
  callerCount  Int
  callees      String[]
  calleeCount  Int
  /// Sem codigo: cOffset e cLength nulos, com o motivo em skipped ("deadline" ou "cap") ou error.
  cOffset      Int?
  cLength      Int?
  truncated    Boolean        @default(false)
  skipped      String?
  error        String?

  @@unique([analysisId, entry])
  @@index([analysisId, rank])
}

enum UnpackStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Desempacotar e extrair (item 7.8): UPX, PyInstaller, Inno Setup, NSIS e arquivo compactado
/// embutido, no servico unpack. Cada arquivo extraido vira uma amostra filha (parentEntryId).
model UnpackJob {
  id            String       @id @default(cuid())
  entryId       String       @unique
  entry         Entry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  status        UnpackStatus @default(PENDING)
  /// Desempacotador que reconheceu o arquivo (upx, pyinstaller, inno, nsis, archive) e o rotulo.
  unpacker      String?
  label         String?
  note          String?
  /// [{ name, size, entryId?, skipped? }]: cada arquivo extraido e a amostra filha criada.
  files         Json?
  /// Detect It Easy (item 7.9): [{ filetype, type, name, version, info, string }].
  detections    Json?
  dieVersion    String?
  dieError      String?
  error         String?
  ms            Int?
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  createdAt     DateTime     @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([status, nextAttemptAt])
}

enum CaptureStatus {
  PENDING
  DONE
  FAILED
}

/// Captura da pagina de um link (item 80) pelo navegador isolado (servico capture):
/// print e HTML no MinIO (captures/<amostra>/<id>.png | .html.txt).
model PageCapture {
  id             String        @id @default(cuid())
  entryId        String
  entry          Entry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  requestedById  String?
  requestedBy    User?         @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  status         CaptureStatus @default(PENDING)
  /// Endereco pedido (o da amostra no momento).
  url            String
  finalUrl       String?
  title          String?
  httpStatus     Int?
  /// [{ url, status }] do pedido inicial ao final.
  redirects      Json?
  /// { subject, issuer, protocol, validFrom, validTo } (null = sem HTTPS).
  certificate    Json?
  /// [{ host, reason }] do que o proxy recusou (rede interna, esquemas).
  blocked        Json?
  screenshotKey  String?
  /// Hash perceptual do topo do print (lib/phash.ts); nulo nas antigas e nas paginas em branco.
  screenshotHash String?
  htmlKey        String?
  htmlTruncated  Boolean       @default(false)
  error          String?
  createdAt      DateTime      @default(now())
  finishedAt     DateTime?

  @@index([entryId, createdAt])
  @@index([screenshotHash])
}

/// Ate onde o escalonamento por prazo ja avisou (item 73).
enum SlaStage {
  WARN
  LATE
}

/// Linha do tempo da amostra: quem fez o que e quando (aba "Historico").
model EntryEvent {
  id        String         @id @default(cuid())
  entryId   String
  entry     Entry          @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /// Quem fez a acao; null = o sistema (ex.: expiracao do sandbox).
  actorId   String?
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      EntryEventType
  /// Valores legiveis "de -> para" (ex.: status, nome do responsavel).
  fromValue String?
  toValue   String?
  detail    String?
  createdAt DateTime       @default(now())

  @@index([entryId, createdAt])
}

enum FavoriteKind {
  VIEW
  ENTRY
}

/// Pasta "Favoritos" do Navegador do Sistema: visoes de lista salvas (URL com os
/// filtros) e amostras fixadas, por usuario.
model Favorite {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      FavoriteKind
  label     String
  /// VIEW: caminho relativo do proprio app (ex.: /history?status=PENDING).
  url       String?
  /// ENTRY: amostra fixada (some dos favoritos se a amostra for apagada).
  entryId   String?
  entry     Entry?       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  position  Int          @default(0)
  createdAt DateTime     @default(now())

  @@unique([userId, entryId])
  @@index([userId, position])
}

enum IocKind {
  IPV4
  DOMAIN
  EMAIL
  MD5
  SHA1
  SHA256
  /// Item 165: IPv6 na forma canonica e URL http/https normalizada (src/lib/ioc-normalize.ts).
  IPV6
  URL
}

/// URLs vistas como indicador (item 165), pela chave: a ficha e a vigilancia usam a chave
/// no endereco, para o link (com token ou e-mail da vitima) nao ir para historico e logs.
model IocUrl {
  /// SHA-256 do valor, em hexadecimal.
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}

/// URL que a pessoa digitou no "Ir para" (POST /api/iocs/resolve). Com "so as proprias
/// amostras" ligado, a ficha pela chave so abre para quem tem a URL em algo visivel ou a
/// digitou; para os outros, a chave conhecida responderia o mesmo 404 da desconhecida.
model IocUrlLookup {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime @default(now())

  @@id([userId, key])
}

/// IOCs normalizados dos relatorios publicados (src/lib/iocs.ts): base do motivo
/// "IOCs em comum" na aba Relacionadas. Reindexado a cada criacao/edicao do relatorio.
model ReportIoc {
  id       String  @id @default(cuid())
  reportId String
  report   Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Copia do entryId do relatorio (agrupa por amostra sem join).
  entryId  String
  entry    Entry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  kind     IocKind
  value    String

  @@unique([reportId, kind, value])
  @@index([kind, value])
  @@index([entryId])
}

enum NotificationType {
  /// Pacote de regras YARA atualizado ou retido (item 150; para admins).
  YARA_PACK_UPDATE
  /// Amostra atribuida ao destinatario.
  ASSIGNED
  /// Amostra do destinatario concluida (detail = veredito).
  COMPLETED
  /// Destinatario mencionado numa atualizacao (detail = trecho).
  MENTION
  /// Atualizacao numa amostra do destinatario ou sob sua responsabilidade.
  COMMENT
  /// Relatorio do destinatario aprovado na revisao / devolvido (detail = comentario).
  REPORT_APPROVED
  REPORT_RETURNED
  /// Indicador seguido apareceu numa amostra nova ou num relatorio (detail = indicador).
  IOC_SEEN
  /// Prazo em alerta / atrasada (item 73; detail = horas do prazo).
  SLA_WARN
  SLA_LATE
  /// Resolucao escrita numa amostra ja concluida do destinatario (item 87; detail = texto).
  RESOLUTION
  /// Casos (item 89; abrem o caso): mencao num comentario e comentario, amostras
  /// incluidas/retiradas e caso atribuido ao destinatario (o responsavel).
  CASE_MENTION
  CASE_COMMENT
  CASE_ENTRY_ADDED
  CASE_ENTRY_REMOVED
  CASE_ASSIGNED
  /// Ambiente do destinatario encerrado pela administracao (plans/monitoramento; detail = motivo).
  SANDBOX_STOPPED_BY_ADMIN
}

/// Caixa de entrada (sininho do masthead): criadas junto com os eventos do
/// historico, nunca para quem fez a acao (src/lib/notifications.ts).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  /// Amostra ou caso (item 89) de que se trata: sempre um dos dois.
  entryId   String?
  entry     Entry?           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  caseId    String?
  case      Case?            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  detail    String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([entryId])
  @@index([caseId])
}

/// Modelos de relatorio (Templates do HPSM): preenchem o "Novo relatorio".
/// Analistas leem; o admin mantem a lista (aba Modelos da Administracao).
model ReportTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  summary     String
  findings    String?
  iocs        String?
  /// Veredito sugerido ao aplicar o modelo.
  verdict     Verdict  @default(UNKNOWN)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Configuracao do sistema feita na tela (item 140); o resto vem do ambiente.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum AuditAction {
  USER_REGISTERED
  USER_ROLE_CHANGED
  USER_SUSPENDED
  USER_LDAP_RELINKED
  USER_REACTIVATED
  USER_PASSWORD_RESET
  USER_PASSWORD_CHANGED
  KEY_CREATED
  KEY_REVOKED
  TEMPLATE_CREATED
  TEMPLATE_UPDATED
  TEMPLATE_DELETED
  YARA_RULE_CREATED
  YARA_RULE_UPDATED
  YARA_RULE_DELETED
  ALLOWLIST_ADDED
  ALLOWLIST_REMOVED
  /// Lista importada (item 78): targetLabel = quantos, detail = motivo.
  ALLOWLIST_IMPORTED
  LOGIN_FAILED
  LOGIN_LOCKED
  API_ACCESS_GRANTED
  API_ACCESS_REVOKED
  API_TOKEN_CREATED
  API_TOKEN_REVOKED
  SESSION_REVOKED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  TWO_FACTOR_RECOVERY_CODES
  TWO_FACTOR_RECOVERY_USED
  PASSKEY_ADDED
