// DeepLook - Prisma schema

// Cliente gerado em src/generated/prisma (fora do git; `npx prisma generate`).
// CommonJS, como o resto da API. A URL do banco fica no prisma.config.ts.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ANALYST
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EntryType {
  FILE
  URL
}

enum EntryStatus {
  PENDING
  IN_REVIEW
  COMPLETED
}

enum Verdict {
  UNKNOWN
  CLEAN
  SUSPICIOUS
  MALICIOUS
}

enum SandboxStatus {
  REQUESTED
  PROVISIONING
  RUNNING
  STOPPING
  STOPPED
  EXPIRED
  FAILED
}

model User {
  id                     String     @id @default(cuid())
  email                  String     @unique
  passwordHash           String
  displayName            String
  role                   Role       @default(USER)
  status                 UserStatus @default(ACTIVE)
  /// Acesso por API: so um admin libera (aba Usuarios). Sem ele, nenhum token vale.
  apiAccess              Boolean    @default(false)
  /// Senha redefinida pelo admin: so entra depois de definir uma nova (item 48).
  mustChangePassword     Boolean    @default(false)
  /// Ultima troca de senha: base da validade (PASSWORD_MAX_AGE_DAYS; admins nao expiram).
  passwordChangedAt      DateTime   @default(now())
  /// 2FA (TOTP, opcional): segredo cifrado (AES-GCM), o pendente da ativacao,
  /// quando foi ativado e o ultimo passo de 30 s aceito (nao repete codigo).
  twoFactorSecret        String?
  twoFactorPendingSecret String?
  twoFactorEnabledAt     DateTime?
  twoFactorLastStep      Int?
  /// Preferencias de uso (pagina inicial, registros por pagina...). Ver src/lib/preferences.ts.
  preferences            Json       @default("{}")
  /// Ultima atividade (GET /api/auth/me) e a visita anterior a ela: base dos
  /// avisos "desde a sua ultima visita" da Pagina Inicial.
  lastSeenAt             DateTime?
  previousSeenAt         DateTime?
  /// Ausente (item 72): o rodizio da atribuicao automatica pula a pessoa.
  away                   Boolean    @default(false)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  sessions          Session[]
  entries           Entry[]                 @relation("EntryOwner")
  /// Amostras sob responsabilidade deste analista (atribuicao).
  assignedEntries   Entry[]                 @relation("EntryAssignee")
  entryEvents       EntryEvent[]
  reports           Report[]                @relation("ReportAuthor")
  sandboxSessions   SandboxSession[]
  createdKeys       ActivationKey[]         @relation("KeyCreator")
  usedKeys          ActivationKey[]         @relation("KeyUser")
  favorites         Favorite[]
  /// Caixa de entrada: notificacoes recebidas e as causadas por este usuario.
  notifications     Notification[]          @relation("NotificationRecipient")
  notified          Notification[]          @relation("NotificationActor")
  reportTemplates   ReportTemplate[]
  reviewedReports   Report[]                @relation("ReportReviewer")
  /// Auditoria: acoes feitas por este usuario e as que o tiveram como alvo.
  auditActions      AuditEvent[]            @relation("AuditActor")
  auditTargets      AuditEvent[]            @relation("AuditTarget")
  /// Amostras que este usuario (admin) moveu para a lixeira.
  trashedEntries    Entry[]                 @relation("EntryDeletedBy")
  apiTokens         ApiToken[]
  recoveryCodes     TwoFactorRecoveryCode[]
  iocWatches        IocWatch[]
  yaraRules         YaraRule[]              @relation("YaraRuleAuthor")
  yaraRulesEdited   YaraRule[]              @relation("YaraRuleEditor")
  teamViews         TeamView[]
  kbCreated         KbArticle[]             @relation("KbAuthor")
  kbUpdated         KbArticle[]             @relation("KbEditor")
  kbRevisions       KbArticleRevision[]
  reportRevisions   ReportRevision[]
  reportEvidence    ReportEvidence[]
  assignmentGroups  AssignmentGroupMember[]
  casesAssigned     Case[]                  @relation("CaseAssignee")
  casesCreated      Case[]                  @relation("CaseAuthor")
  caseEntriesAdded  CaseEntry[]
  caseEvents        CaseEvent[]
  yaraRetroscans    YaraRetroscan[]
  allowedIndicators AllowedIndicator[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  /// Aba Sessoes da Minha Conta (item 61): de onde e quando foi usada por ultimo.
  userAgent  String?
  ip         String?
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model ActivationKey {
  id        String    @id @default(cuid())
  code      String    @unique
  role      Role      @default(USER)
  maxUses   Int       @default(1)
  usesUsed  Int       @default(0)
  expiresAt DateTime?
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  createdById String
  createdBy   User   @relation("KeyCreator", fields: [createdById], references: [id])
  usedBy      User[] @relation("KeyUser")
}

model Entry {
  id              String      @id @default(cuid())
  ownerId         String
  owner           User        @relation("EntryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  type            EntryType
  title           String
  description     String?
  status          EntryStatus @default(PENDING)
  verdict         Verdict     @default(UNKNOWN)
  /// Prioridade (item 53): define o prazo de alerta/atraso (src/lib/sla.ts).
  priority        Priority    @default(P3)
  /// Quando a amostra entrou no status atual (idade na fila / prazo). Mantido por
  /// um trigger no Postgres a cada mudanca de status (migracao entry_status_changed_at).
  statusChangedAt DateTime    @default(now())
  /// Escalonamento por prazo (item 73): ate onde ja avisou no status atual
  /// (src/lib/sla-escalation.ts). O trigger de status volta para null.
  slaStage        SlaStage?

  /// Analista responsavel pela amostra (atribuicao); null = sem responsavel.
  assigneeId String?
  assignee   User?   @relation("EntryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Duplicata de outra amostra (a principal); herda o veredito dela.
  duplicateOfId String?
  duplicateOf   Entry?  @relation("EntryDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Entry[] @relation("EntryDuplicate")

  originalFilename String?
  storageKey       String?
  bucket           String?
  fileSize         Int?
  mimeType         String?
  sha256           String?
  /// Hash parecido (TLSH, item 71; 70 hex sem o "T1"). Vazio = nao calculavel
  /// (arquivo pequeno/simples demais ou acima de 32 MB); null = ainda nao calculado.
  tlsh             String?
  /// Analise estatica do arquivo no envio (src/lib/static-analysis.ts): tipo real,
  /// entropia, strings e cabecalho PE. So leitura de bytes; null em URLs.
  staticInfo       Json?
  /// E-mail (.eml) lido no envio (src/lib/eml.ts): cabecalhos, autenticacao,
  /// caminho, links e corpo em texto. Cada anexo vira uma amostra filha.
  emailInfo        Json?
  /// Anexo de um e-mail enviado (amostra pai = o .eml).
  parentEntryId    String?
  parentEntry      Entry?    @relation("EntryAttachments", fields: [parentEntryId], references: [id], onDelete: SetNull)
  attachmentsOf    Entry[]   @relation("EntryAttachments")
  /// Arquivo apagado do armazenamento pela retencao (RETENTION_DAYS); ficha,
  /// relatorios, IOCs e hash continuam (src/lib/retention.ts).
  filePurgedAt     DateTime?

  url       String?
  urlDomain String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Lixeira (admin): some de todas as telas ate ser restaurada ou excluida de
  /// vez. O filtro e automatico nas consultas de Entry (src/lib/prisma.ts).
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("EntryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  reports         Report[]
  tags            Tag[]
  sandboxSessions SandboxSession[]
  events          EntryEvent[]
  favorites       Favorite[]
  reportIocs      ReportIoc[]
  notifications   Notification[]
  reputation      ReputationResult[]
  antivirus       AntivirusScan?
  yara            YaraScan?
  caseLinks       CaseEntry[]
  caseEvents      CaseEvent[]
  yaraRetroHits   YaraRetroscanHit[]

  @@index([ownerId])
  @@index([assigneeId])
  @@index([sha256])
  @@index([createdAt])
  /// Aba "Relacionadas": amostras do mesmo dominio.
  @@index([urlDomain])
  /// Fila "Atrasadas" e ordenacao por idade.
  @@index([status, statusChangedAt])
  @@index([priority, status, statusChangedAt])
  @@index([duplicateOfId])
  @@index([deletedAt])
}

model Tag {
  id      String  @id @default(cuid())
  name    String  @unique
  entries Entry[]
}

/// Grupo de analistas da atribuicao automatica (item 72), ex.: Phishing, Malware.
model AssignmentGroup {
  id        String                  @id @default(cuid())
  name      String                  @unique
  createdAt DateTime                @default(now())
  members   AssignmentGroupMember[]
  rules     AssignmentRule[]
}

/// Membro de um grupo; o rodizio escolhe quem recebeu ha mais tempo.
model AssignmentGroupMember {
  groupId        String
  group          AssignmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ultima amostra recebida por este grupo (null = nunca: vem primeiro).
  lastAssignedAt DateTime?

  @@id([groupId, userId])
}

/// Regra: amostra nova do tipo / com a tag / da prioridade -> grupo. Campos
/// vazios valem para qualquer valor; a primeira regra ativa que casar vale.
model AssignmentRule {
  id        String          @id @default(cuid())
  position  Int
  groupId   String
  group     AssignmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entryType EntryType?
  tag       String?
  priority  Priority?
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@index([position])
}

model Report {
  id               String       @id @default(cuid())
  entryId          String
  entry            Entry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  analystId        String
  analyst          User         @relation("ReportAuthor", fields: [analystId], references: [id])
  summary          String
  findings         String?
  iocs             String?
  verdict          Verdict      @default(UNKNOWN)
  /// Tecnicas MITRE ATT&CK (ex.: T1566.001), validadas na lista embutida (src/lib/attack.ts).
  attackTechniques String[]     @default([])
  /// Rascunho -> (Em revisao ->) Publicado. Ver REPORT_REVIEW_REQUIRED.
  status           ReportStatus @default(DRAFT)
  /// Revisao (quatro olhos): quem aprovou/devolveu, quando e o comentario da devolucao.
  submittedAt      DateTime?
  reviewedById     String?
  reviewedBy       User?        @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  /// Artigos da base de conhecimento citados (item 63).
  kbArticles    KbArticle[] @relation("ReportKbArticles")
  /// Indicadores extraidos do campo `iocs` (so de relatorios publicados).
  extractedIocs ReportIoc[]
  /// Versoes anteriores (item 75), uma por edicao do conteudo.
  revisions     ReportRevision[]
  /// Imagens de evidencia (item 76).
  evidence      ReportEvidence[]

  @@index([entryId])
  @@index([status])
  @@index([attackTechniques], type: Gin)
}

/// Versao anterior de um relatorio (item 75): guardada a cada edicao do conteudo.
/// A versao N+1 e de quem fez a edicao (`editor`) em `createdAt`; a 1a e do autor.
model ReportRevision {
  id               String       @id @default(cuid())
  reportId         String
  report           Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Quem fez a edicao que substituiu esta versao.
  editorId         String?
  editor           User?        @relation(fields: [editorId], references: [id], onDelete: SetNull)
  summary          String
  findings         String?
  iocs             String?
  verdict          Verdict
  attackTechniques String[]     @default([])
  /// Situacao do relatorio enquanto esta versao valia.
  status           ReportStatus
  /// Quando foi substituida.
  createdAt        DateTime     @default(now())

  @@index([reportId, createdAt])
}

/// Imagem de evidencia do relatorio (item 76): PNG/JPEG/WebP validada pelo tipo
/// real e sem metadados (src/lib/evidence-image.ts), guardada no MinIO.
model ReportEvidence {
  id           String   @id @default(cuid())
  reportId     String
  report       Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  /// Chave no bucket S3_BUCKET (evidence/<relatorio>/<uuid>.<ext>).
  storageKey   String
  mimeType     String
  width        Int
  height       Int
  size         Int
  caption      String?
  createdAt    DateTime @default(now())

  @@index([reportId, createdAt])
}

enum ReportStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

/// VM isolada (clone do template no Proxmox) usada para analisar uma amostra.
model SandboxSession {
  id        String @id @default(cuid())
  entryId   String
  entry     Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  analystId String
  analyst   User   @relation(fields: [analystId], references: [id], onDelete: Cascade)

  node      String
  vmid      Int?
  name      String
  status    SandboxStatus @default(REQUESTED)
  /// Etapa atual do provisionamento (texto curto mostrado na UI).
  phase     String?
  /// Volume do ISO gerado com a amostra (para limpar depois).
  isoVolume String?
  /// UPID da task do Proxmox em andamento (clone/start/upload).
  upid      String?
  ip        String?
  lastError String?

  expiresAt DateTime
  startedAt DateTime?
  stoppedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, expiresAt])
  @@index([entryId])
  @@index([analystId])
}

/// Tipos de evento do historico (auditoria) de uma amostra.
enum EntryEventType {
  CREATED
  STATUS_CHANGED
  VERDICT_CHANGED
  ASSIGNED
  REPORT_CREATED
  REPORT_PUBLISHED
  /// Relatorio enviado para revisao / aprovado / devolvido (detail = comentario).
  REPORT_SUBMITTED
  REPORT_APPROVED
  REPORT_RETURNED
  SANDBOX_OPENED
  SANDBOX_CLOSED
  SANDBOX_FAILED
  /// Atualizacao/comentario livre (texto puro no `detail`).
  COMMENT
  /// Marcada como duplicata (fromValue: situacao anterior em JSON; detail: id da principal).
  MARKED_DUPLICATE
  /// Deixou de ser duplicata (detail: id da principal anterior).
  UNMARKED_DUPLICATE
  /// Prioridade mudou (fromValue/toValue: P1..P4).
  PRIORITY_CHANGED
  /// Arquivo expurgado pela retencao (detail: politica aplicada).
  FILE_PURGED
  /// Movida para a lixeira / restaurada (admin).
  TRASHED
  RESTORED
  /// Incluida num caso / retirada dele (detail: codigo do caso, ex.: CASO-0007).
  CASE_ADDED
  CASE_REMOVED
  /// Prazo em alerta / atrasada (item 73; fromValue = prioridade, detail = horas do prazo).
  SLA_WARN
  SLA_LATE
}

/// Ate onde o escalonamento por prazo ja avisou (item 73).
enum SlaStage {
  WARN
  LATE
}

/// Linha do tempo da amostra: quem fez o que e quando (aba "Historico").
model EntryEvent {
  id        String         @id @default(cuid())
  entryId   String
  entry     Entry          @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /// Quem fez a acao; null = o sistema (ex.: expiracao do sandbox).
  actorId   String?
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      EntryEventType
  /// Valores legiveis "de -> para" (ex.: status, nome do responsavel).
  fromValue String?
  toValue   String?
  detail    String?
  createdAt DateTime       @default(now())

  @@index([entryId, createdAt])
}

enum FavoriteKind {
  VIEW
  ENTRY
}

/// Pasta "Favoritos" do Navegador do Sistema: visoes de lista salvas (URL com os
/// filtros) e amostras fixadas, por usuario.
model Favorite {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      FavoriteKind
  label     String
  /// VIEW: caminho relativo do proprio app (ex.: /history?status=PENDING).
  url       String?
  /// ENTRY: amostra fixada (some dos favoritos se a amostra for apagada).
  entryId   String?
  entry     Entry?       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  position  Int          @default(0)
  createdAt DateTime     @default(now())

  @@unique([userId, entryId])
  @@index([userId, position])
}

enum IocKind {
  IPV4
  DOMAIN
  EMAIL
  MD5
  SHA1
  SHA256
}

/// IOCs normalizados dos relatorios publicados (src/lib/iocs.ts): base do motivo
/// "IOCs em comum" na aba Relacionadas. Reindexado a cada criacao/edicao do relatorio.
model ReportIoc {
  id       String  @id @default(cuid())
  reportId String
  report   Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Copia do entryId do relatorio (agrupa por amostra sem join).
  entryId  String
  entry    Entry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  kind     IocKind
  value    String

  @@unique([reportId, kind, value])
  @@index([kind, value])
  @@index([entryId])
}

enum NotificationType {
  /// Amostra atribuida ao destinatario.
  ASSIGNED
  /// Amostra do destinatario concluida (detail = veredito).
  COMPLETED
  /// Destinatario mencionado numa atualizacao (detail = trecho).
  MENTION
  /// Atualizacao numa amostra do destinatario ou sob sua responsabilidade.
  COMMENT
  /// Relatorio do destinatario aprovado na revisao / devolvido (detail = comentario).
  REPORT_APPROVED
  REPORT_RETURNED
  /// Indicador seguido apareceu numa amostra nova ou num relatorio (detail = indicador).
  IOC_SEEN
  /// Prazo em alerta / atrasada (item 73; detail = horas do prazo).
  SLA_WARN
  SLA_LATE
}

/// Caixa de entrada (sininho do masthead): criadas junto com os eventos do
/// historico, nunca para quem fez a acao (src/lib/notifications.ts).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  entryId   String
  entry     Entry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  detail    String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Modelos de relatorio (Templates do HPSM): preenchem o "Novo relatorio".
/// Analistas leem; o admin mantem a lista (aba Modelos da Administracao).
model ReportTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  summary     String
  findings    String?
  iocs        String?
  /// Veredito sugerido ao aplicar o modelo.
  verdict     Verdict  @default(UNKNOWN)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AuditAction {
  USER_REGISTERED
  USER_ROLE_CHANGED
  USER_SUSPENDED
  USER_REACTIVATED
  USER_PASSWORD_RESET
  USER_PASSWORD_CHANGED
  KEY_CREATED
  KEY_REVOKED
  TEMPLATE_CREATED
  TEMPLATE_UPDATED
  TEMPLATE_DELETED
  YARA_RULE_CREATED
  YARA_RULE_UPDATED
  YARA_RULE_DELETED
  ALLOWLIST_ADDED
  ALLOWLIST_REMOVED
  /// Lista importada (item 78): targetLabel = quantos, detail = motivo.
  ALLOWLIST_IMPORTED
  LOGIN_FAILED
  LOGIN_LOCKED
  API_ACCESS_GRANTED
  API_ACCESS_REVOKED
  API_TOKEN_CREATED
  API_TOKEN_REVOKED
  SESSION_REVOKED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  TWO_FACTOR_RECOVERY_CODES
  TWO_FACTOR_RECOVERY_USED
  ENTRY_TRASHED
  ENTRY_RESTORED
  ENTRY_DELETED
}

/// Auditoria administrativa (aba Auditoria da Administracao): quem fez o que,
/// em quem e de onde. Nunca guarda senhas (src/lib/audit.ts).
model AuditEvent {
  id           String      @id @default(cuid())
  action       AuditAction
  actorId      String?
  actor        User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?       @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  /// Rotulo do alvo no momento (e-mail, codigo da chave, nome do modelo).
  targetLabel  String?
  detail       String?
  ip           String?
  createdAt    DateTime    @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}

/// Token de API pessoal (Minha Conta > Tokens de API): so envio e consulta de
/// amostras (src/lib/api-tokens.ts). Guarda so o hash; o token aparece uma vez.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// Comeco do token ("dlk_xxxxxxxx"), para reconhecer qual e qual.
  prefix     String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime?
  lastUsedIp String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

enum ReputationKind {
  HASH
  DOMAIN
  IP
}

enum ReputationStatus {
  PENDING
  FOUND
  NOT_FOUND
  ERROR
}

/// Reputacao externa da amostra (src/lib/reputation.ts): um resultado por servico.
/// So o indicador sai do servidor (SHA-256 ou dominio/IP), nunca o arquivo.
model ReputationResult {
  id        String           @id @default(cuid())
  entryId   String
  entry     Entry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /// virustotal, malwarebazaar, urlhaus, threatfox, abuseipdb
  service   String
  kind      ReputationKind
  indicator String
  status    ReputationStatus
  verdict   Verdict          @default(UNKNOWN)
  summary   String
  link      String?
  details   Json?
  checkedAt DateTime         @default(now())

  @@unique([entryId, service])
  /// Cache de 24 h: mesmo servico e indicador em outra amostra.
  @@index([service, indicator, checkedAt])
}

enum AvStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

/// Varredura do ClamAV (src/lib/clamav.ts): a mais recente de cada amostra.
model AntivirusScan {
  id        String    @id @default(cuid())
  entryId   String    @unique
  entry     Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  status    AvStatus
  /// Nome da assinatura quando infectado (ex.: Win.Test.EICAR_HDB-1).
  signature String?
  error     String?
  engine    String?
  dbVersion Int?
  dbDate    DateTime?
  scannedAt DateTime  @default(now())

  @@index([scannedAt])
}

/// Codigos de recuperacao do 2FA (uso unico; so o hash).
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, codeHash])
}

/// Prioridade da amostra: P1 Critica, P2 Alta, P3 Media (padrao), P4 Baixa.
enum Priority {
  P1
  P2
  P3
  P4
}

/// Alertas de IOC (item 60): indicadores que a pessoa segue.
model IocWatch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      IocKind
  value     String
  createdAt DateTime @default(now())

  @@unique([userId, kind, value])
  @@index([kind, value])
}

/// Regras YARA (item 56): escritas pelos analistas, validadas e aplicadas pela
/// API com o YARA-X (src/lib/yara.ts) a cada arquivo enviado.
model YaraRule {
  id          String          @id @default(cuid())
  /// Nome do conjunto (unico); o arquivo pode ter varias regras.
  name        String          @unique
  description String?
  source      String
  enabled     Boolean         @default(true)
  createdById String?
  createdBy   User?           @relation("YaraRuleAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?           @relation("YaraRuleEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  retroscans  YaraRetroscan[]
}

enum YaraStatus {
  PENDING
  CLEAN
  MATCHED
  ERROR
}

/// Ultima varredura YARA da amostra (acertos em JSON: conjunto, regra, tags).
model YaraScan {
  id         String     @id @default(cuid())
  entryId    String     @unique
  entry      Entry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  status     YaraStatus
  matches    Json       @default("[]")
  /// Quantos conjuntos ativos foram aplicados.
  rulesCount Int        @default(0)
  error      String?
  scannedAt  DateTime   @default(now())
}

/// Visoes da equipe (item 62): visoes do Historico Global compartilhadas pelos
/// analistas (pasta "Visoes da equipe" do navegador, com contador).
model TeamView {
  id          String   @id @default(cuid())
  label       String
  /// Caminho relativo (/history?...): uma visao por endereco.
  url         String   @unique
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum KbCategory {
  MALWARE_FAMILY
  SCAM
  TECHNIQUE
  PROCEDURE
}

/// Base de conhecimento (item 63): artigos em Markdown; todos leem, analistas escrevem.
model KbArticle {
  id          String              @id @default(cuid())
  title       String              @unique
  summary     String
  category    KbCategory
  tags        String[]            @default([])
  body        String
  createdById String?
  createdBy   User?               @relation("KbAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?               @relation("KbEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  revisions   KbArticleRevision[]
  reports     Report[]            @relation("ReportKbArticles")

  @@index([category, updatedAt])
}

/// Versao anterior de um artigo (guardada a cada edicao; o artigo mostra quem e quando).
model KbArticleRevision {
  id        String    @id @default(cuid())
  articleId String
  article   KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editorId  String?
  editor    User?     @relation(fields: [editorId], references: [id], onDelete: SetNull)
  title     String
  summary   String
  body      String
  createdAt DateTime  @default(now())

  @@index([articleId, createdAt])
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

/// Casos (item 55): amostras da mesma campanha (so analistas). Sem relatorio
/// proprio e nunca vazio (routes/cases.ts).
model Case {
  id          String      @id @default(cuid())
  /// Numero sequencial exibido como CASO-0001.
  number      Int         @unique @default(autoincrement())
  title       String
  description String?
  status      CaseStatus  @default(OPEN)
  assigneeId  String?
  assignee    User?       @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?       @relation("CaseAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  closedAt    DateTime?
  entries     CaseEntry[]
  events      CaseEvent[]

  @@index([status, updatedAt])
  @@index([assigneeId, status])
}

/// Amostra num caso (uma amostra pode estar em varios).
model CaseEntry {
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  addedById String?
  addedBy   User?    @relation(fields: [addedById], references: [id], onDelete: SetNull)
  addedAt   DateTime @default(now())

  @@id([caseId, entryId])
  @@index([entryId])
}

enum CaseEventType {
  CREATED
  ENTRY_ADDED
  ENTRY_REMOVED
  STATUS_CHANGED
  ASSIGNED
  UPDATED
  COMMENT
}

/// Linha do tempo do caso (inclusoes, status, responsavel, comentarios).
model CaseEvent {
  id        String        @id @default(cuid())
  caseId    String
  case      Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      CaseEventType
  detail    String?
  fromValue String?
  toValue   String?
  entryId   String?
  entry     Entry?        @relation(fields: [entryId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@index([caseId, createdAt])
}

enum YaraRetroStatus {
  RUNNING
  DONE
  CANCELLED
  FAILED
}

/// Varredura retroativa de uma regra YARA nas amostras ja guardadas (item 67).
/// Uma por vez; progresso em scanned/total (lib/yara-retro.ts).
model YaraRetroscan {
  id          String             @id @default(cuid())
  ruleId      String?
  rule        YaraRule?          @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  /// Nome da regra no inicio (fica mesmo se a regra for excluida).
  ruleName    String
  status      YaraRetroStatus    @default(RUNNING)
  total       Int
  scanned     Int                @default(0)
  matched     Int                @default(0)
  /// Arquivos que nao puderam ser lidos ou varridos.
  failed      Int                @default(0)
  /// Arquivos acima do limite de tamanho da varredura retroativa.
  skipped     Int                @default(0)
  startedById String?
  startedBy   User?              @relation(fields: [startedById], references: [id], onDelete: SetNull)
  startedAt   DateTime           @default(now())
  finishedAt  DateTime?
  error       String?
  hits        YaraRetroscanHit[]

  @@index([startedAt])
}

/// Amostra que casou numa varredura retroativa.
model YaraRetroscanHit {
  retroscanId String
  retroscan   YaraRetroscan @relation(fields: [retroscanId], references: [id], onDelete: Cascade)
  entryId     String
  entry       Entry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /// Regras (identificadores) do conjunto que casaram.
  identifiers String[]
  createdAt   DateTime      @default(now())

  @@id([retroscanId, entryId])
}

/// Lista de permissoes (item 69): indicadores legitimos que nao ligam amostras,
/// nao disparam alertas e somem das sugestoes. IPV4 aceita faixa CIDR
/// (ex.: 10.0.0.0/8); DOMAIN vale tambem para os subdominios.
model AllowedIndicator {
  id          String   @id @default(cuid())
  kind        IocKind
  value       String
  reason      String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([kind, value])
}
