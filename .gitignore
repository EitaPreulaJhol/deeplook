# deps / build
node_modules/
dist/
build/

# env & secrets: .env e qualquer copia (.env.bak, .env.prod...), menos o modelo
.env
.env.*
!.env.example

# runtime data (volumes)
data/

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# cliente do Prisma 7 (gerado por `npx prisma generate`)
apps/api/src/generated/
apps/api/tests/.tmp/

# runs do strix
strix_runs/
.source-aware/

# entradas que quebraram o fuzzing (apps/api: npm run test:fuzz)
apps/api/tests/fuzz/crashes/

# Planos, roadmap e backlog do projeto: so locais, fora do Git.
plans/

# Pacotes de implantacao gerados por scripts/package-deploy.mjs.
release/

# Arquivos diversos
.claude

# Biblioteca de icones Silk (origem dos de apps/web/public/icons): so local, fora do Git.
icons/
sbom/

# YARA Forge instalado no servidor pelo apps/api/scripts/vendor-yara-forge.mjs (licencas por
# conjunto, algumas GPL ou sem licenca): fica fora do repositorio.
apps/api/rules/yara-forge/
apps/api/rules/local-packs.json
