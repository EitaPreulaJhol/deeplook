# ============================================================
# DeepLook - exemplo de variaveis de ambiente
# Copie para .env e ajuste os valores sensiveis:
#   cp .env.example .env
# O docker-compose le o arquivo .env automaticamente (sem env_file).
# ============================================================

# ---- Banco de dados (PostgreSQL) ----
POSTGRES_USER=deeplook
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=deeplook

# ---- Sessao / Auth ----
# Gere algo aleatorio e longo, ex.:  openssl rand -hex 32
SESSION_SECRET=change-me-please-use-a-long-random-secret
SESSION_TTL_HOURS=168
# Coloque true quando estiver servindo somente em HTTPS (Cloudflare Tunnel)
COOKIE_SECURE=false

# ---- Admin semeado no primeiro boot ----
ADMIN_EMAIL=admin@deeplook.local
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Administrator

# ---- Uploads ----
MAX_UPLOAD_MB=200

# ---- MinIO / S3 ----
# Imagem do MinIO. Oficial (atual): quay.io/minio/minio:latest
# Alternativa no Docker Hub (espelho da comunidade): elestio/minio:latest
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_ROOT_USER=deeplook
MINIO_ROOT_PASSWORD=change-me-minio-password
# Porta (loopback) do console web do MinIO no host
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=deeplook
S3_SECRET_KEY=change-me-minio-password
S3_BUCKET=deeplook-samples
S3_FORCE_PATH_STYLE=true

# ---- Porta publicada no host (apontada pelo Cloudflare Tunnel) ----
WEB_PORT=8080
