# ============================================================
# DeepLook - exemplo de variaveis de ambiente
# Copie para .env e ajuste os valores sensiveis:
#   cp .env.example .env
# O docker-compose le o arquivo .env automaticamente (sem env_file).
# ============================================================

# ---- Banco de dados (PostgreSQL) ----
POSTGRES_USER=deeplook
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=deeplook

# ---- Sessao / Auth ----
# Gere algo aleatorio e longo, ex.:  openssl rand -hex 32
# Obrigatorio trocar: com este valor a API nao sobe (openssl rand -hex 32)
SESSION_SECRET=change-me-please-use-a-long-random-secret
SESSION_TTL_HOURS=168
# Sessao expira apos N minutos sem atividade do usuario (aviso 2 min antes)
SESSION_IDLE_MINUTES=30
# Prazo das amostras nao concluidas (horas no status atual): bolinha laranja / vermelha
SLA_WARN_HOURS=24
SLA_LATE_HOURS=72
# Prazos das outras prioridades ("alerta/atraso" em horas); P3 usa os dois acima
SLA_P1_HOURS=2/4
SLA_P2_HOURS=8/24
SLA_P4_HOURS=72/120
# Alerta/atraso avisam na Caixa de entrada; true = ao atrasar, sobe a prioridade um nivel
SLA_ESCALATE_PRIORITY=false
# true = relatorio so e publicado com a aprovacao de outro analista (quatro olhos)
REPORT_REVIEW_REQUIRED=false
# Retencao: apaga o ARQUIVO das amostras concluidas ha mais de N dias (ficha, relatorios,
# IOCs e hash ficam). 0 = desligada
RETENTION_DAYS=0
# Backup em ZIP (Administracao > Backup): dias ate o ZIP expirar e o comando do pg_dump
# (precisa ser da versao 16 ou mais nova; a imagem da API ja traz)
BACKUP_RETENTION_DAYS=7
BACKUP_PG_DUMP=pg_dump
# Conferencia de integridade: de tempos em tempos a API le os arquivos guardados e compara o
# SHA-256 com o da ficha (as nunca conferidas primeiro). Intervalo em minutos (0 desliga) e
# quantos MB ler por rodada. O download tambem confere, sem ler duas vezes.
INTEGRITY_SCRUB_INTERVAL_MINUTES=60
INTEGRITY_SCRUB_MAX_MB=512
# Login pelo AD/LDAP (opcional; vazio desliga). So com TLS: ldaps:// ou ldap:// com
# LDAP_STARTTLS=true; LDAP_TLS_CA = PEM da CA interna (monte o arquivo no container da API)
LDAP_URL=
LDAP_STARTTLS=false
LDAP_TLS_CA=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
# {login} = o que a pessoa digitou. Vazio = sAMAccountName, userPrincipalName ou mail
LDAP_USER_FILTER=
LDAP_ATTR_NAME=displayName
LDAP_ATTR_MAIL=mail
LDAP_ANALYST_GROUP=
LDAP_ADMIN_GROUP=
# true: quem esta num grupo dentro desses grupos tambem ganha o papel
LDAP_NESTED_GROUPS=false
# Validade da senha em dias (admins nao expiram). 0 = sem validade
PASSWORD_MAX_AGE_DAYS=90
# Reputacao externa: consulta automatica no envio, so com o indicador (SHA-256 do arquivo;
# dominio ou IP do link). Deixe vazio para desligar cada servico.
VT_API_KEY=
# Uma chave da abuse.ch (auth.abuse.ch) serve para MalwareBazaar, URLhaus e ThreatFox
ABUSECH_AUTH_KEY=
ABUSEIPDB_API_KEY=
# Antivirus ClamAV (servico clamav do docker-compose). Deixe CLAMAV_HOST= vazio para desligar
# (o servico clamav pode ser removido do compose nesse caso).
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Captura da pagina de um link (servico capture do docker-compose: navegador isolado, sem
# acesso a rede interna). Deixe CAPTURE_URL= vazio para desligar. Troque o token (16+).
CAPTURE_URL=http://capture:3100
CAPTURE_TOKEN=troque-este-token-da-captura
# Coloque true quando estiver servindo somente em HTTPS (Cloudflare Tunnel)
COOKIE_SECURE=false

# ---- Admin semeado no primeiro boot ----
ADMIN_EMAIL=admin@deeplook.local
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Administrator

# ---- Uploads ----
MAX_UPLOAD_MB=200
# Envios ao mesmo tempo somam ate isto em memoria; acima, "tente de novo em instantes"
MAX_UPLOAD_MEMORY_MB=600
# Limite de memoria do container da API
API_MEM_LIMIT=4g
# Envios por usuario comum nas ultimas 24 horas (0 desliga; analistas e admins sem limite).
UPLOAD_DAILY_LIMIT=20

# ---- MinIO / S3 ----
# Imagem do MinIO. Oficial (atual): quay.io/minio/minio:latest
# Alternativa no Docker Hub (espelho da comunidade): elestio/minio:latest
MINIO_IMAGE=pgsty/silo@sha256:7bb2aff6b89efe1cb1303c10fc21d579447434ed06649ac9ec05a5e2dbf30ad7
MINIO_ROOT_USER=deeplook
MINIO_ROOT_PASSWORD=change-me-minio-password
# Porta (loopback) do console web do MinIO no host
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=deeplook
S3_SECRET_KEY=change-me-minio-password
S3_BUCKET=deeplook-samples
S3_FORCE_PATH_STYLE=true

# ---- Porta publicada no host (apontada pelo Cloudflare Tunnel) ----
WEB_PORT=8080
# Limite de memoria do container do web (nginx)
WEB_MEM_LIMIT=256m

# ---- Logs do Docker (rotacao, todos os servicos) ----
# Tamanho de cada arquivo de log e quantos ficam; sem limite o disco enche aos poucos.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ============================================================
# Sandbox de analise (VM isolada no Proxmox VE)
# ============================================================
# Deixe false para o stack funcionar sem Proxmox (feature inerte).
SANDBOX_ENABLED=false
# Mostra o console (noVNC) no painel do analista.
SANDBOX_CONSOLE_ENABLED=true
#
# PROXMOX_MOCK=true simula o Proxmox em memoria: da para desenvolver e
# testar todo o fluxo (provisionar, console, descartar) sem ter um PVE.
PROXMOX_MOCK=false
#
# ---- Conexao com o Proxmox VE ----
# URL da API do PVE (porta 8006). Ex.: https://192.168.0.10:8006
PROXMOX_API_URL=
# Node do cluster onde as VMs serao criadas. Ex.: pve
PROXMOX_NODE=pve
# Usuario dedicado (obrigatorio: o console NAO aceita API token, so ticket).
# Ex.: deeplook@pve
PROXMOX_USER=
PROXMOX_PASSWORD=
# VMID do template (com qemu-guest-agent e rede isolada).
PROXMOX_TEMPLATE_VMID=0
# Storage que aceita content "iso" (onde a amostra vira ISO read-only).
PROXMOX_ISO_STORAGE=local
# true apenas se o certificado do PVE for confiavel (senao deixe false).
PROXMOX_VERIFY_TLS=false
#
# ---- Politica das VMs ----
# Etiqueta usada para identificar/limpar VMs orfas criadas pelo DeepLook.
SANDBOX_TAG=deeplook-sandbox
# Tempo de vida da VM (minutos) antes do reaper destruir.
SANDBOX_TTL_MINUTES=60
# Maximo de VMs ativas no total e por analista.
SANDBOX_MAX_ACTIVE=4
SANDBOX_MAX_PER_USER=2
# No modo mock: URL ws:// de um VNC de teste (opcional) para validar o console.
SANDBOX_MOCK_VNC_URL=
