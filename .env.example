# ============================================================
# DeepLook - exemplo de variaveis de ambiente
# Copie para .env e ajuste os valores sensiveis:
#   cp .env.example .env
# O docker-compose le o arquivo .env automaticamente (sem env_file).
# ============================================================

# ---- Banco de dados (PostgreSQL) ----
# Com a senha deste exemplo (ou a do compose, "deeplook") a API nao sobe em producao. Num banco que
# ja existe, mudar aqui nao muda a senha gravada: use ALTER USER antes (docs/implantacao.md, passo 1).
POSTGRES_USER=deeplook
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=deeplook

# ---- Sessao / Auth ----
# Gere algo aleatorio e longo, ex.:  openssl rand -hex 32
# Obrigatorio trocar: com este valor a API nao sobe (openssl rand -hex 32)
SESSION_SECRET=change-me-please-use-a-long-random-secret
# Chave de dados: cifra o segredo do 2FA guardado no banco. Gere com `openssl rand -hex 32` e
# GUARDE junto do backup: sem ela, os 2FA ativados param de funcionar. Vazia, a chave sai do
# SESSION_SECRET (modo antigo), e trocar o SESSION_SECRET quebra o 2FA de todas as contas. Ao
# definir, a API recifra na subida o que estava no modo antigo. Diferente do SESSION_SECRET.
DATA_KEY=
# So durante a troca do DATA_KEY: a chave antiga aqui e a nova acima. A subida recifra tudo com a
# nova (o log e o status do sistema dizem quando terminou); depois, apague esta linha.
# DATA_KEY_PREVIOUS=
# So para demonstracao local: sobe mesmo com os segredos e senhas publicos deste arquivo.
# Nunca em producao.
# ALLOW_INSECURE_DEFAULTS=false
SESSION_TTL_HOURS=168
# Sessao expira apos N minutos sem atividade do usuario (aviso 2 min antes)
SESSION_IDLE_MINUTES=30
# Prazo das amostras nao concluidas (horas no status atual): bolinha laranja / vermelha
SLA_WARN_HOURS=24
SLA_LATE_HOURS=72
# Prazos das outras prioridades ("alerta/atraso" em horas); P3 usa os dois acima
SLA_P1_HOURS=2/4
SLA_P2_HOURS=8/24
SLA_P4_HOURS=72/120
# Alerta/atraso avisam na Caixa de entrada; true = ao atrasar, sobe a prioridade um nivel
SLA_ESCALATE_PRIORITY=false
# true = relatorio so e publicado com a aprovacao de outro analista (quatro olhos)
REPORT_REVIEW_REQUIRED=false
# Retencao: apaga o ARQUIVO das amostras concluidas ha mais de N dias (ficha, relatorios,
# IOCs e hash ficam). 0 = desligada
RETENTION_DAYS=0
# Backup em ZIP (Administracao > Backup): dias ate o ZIP expirar e o comando do pg_dump
# (precisa ser da versao 16 ou mais nova; a imagem da API ja traz)
BACKUP_RETENTION_DAYS=7
BACKUP_PG_DUMP=pg_dump
# Pasta do host onde os backups sao gravados (item 6.13). Vazio: o ZIP fica no bucket do MinIO,
# no MESMO disco dos dados, e perder o disco perde dado e backup. Aponte para um disco externo ou
# um NAS montado no host; levar dali para fora e responsabilidade de quem configura o ambiente.
# A pasta precisa: existir, ser gravavel pela API (uid 1000) e ter o arquivo .deeplook-backups,
# criado por voce. Sem ele a API recusa gravar, porque um disco desmontado deixa no lugar uma
# pasta vazia no disco principal:
#   mkdir -p /mnt/externo/deeplook && touch /mnt/externo/deeplook/.deeplook-backups
#   sudo chown -R 1000:1000 /mnt/externo/deeplook
BACKUP_DIR=
# Senha do ZIP do backup agendado (12+ caracteres). Os dias e o horario se escolhem na aba
# Administracao > Backup; o ZIP agendado leva os arquivos das amostras (malware) e sai sempre com
# esta senha. Vazia, o agendamento nao liga. Guarde-a fora deste servidor: sem ela, o backup nao abre.
BACKUP_SCHEDULE_PASSWORD=
# Conferencia de integridade: de tempos em tempos a API le os arquivos guardados e compara o
# SHA-256 com o da ficha (as nunca conferidas primeiro). Intervalo em minutos (0 desliga) e
# quantos MB ler por rodada. O download tambem confere, sem ler duas vezes.
INTEGRITY_SCRUB_INTERVAL_MINUTES=60
INTEGRITY_SCRUB_MAX_MB=512
# Login pelo AD/LDAP (opcional; vazio desliga). So com TLS: ldaps:// ou ldap:// com
# LDAP_STARTTLS=true; LDAP_TLS_CA = PEM da CA interna (monte o arquivo no container da API)
LDAP_URL=
LDAP_STARTTLS=false
LDAP_TLS_CA=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
# {login} = o que a pessoa digitou. Vazio = sAMAccountName, userPrincipalName ou mail
LDAP_USER_FILTER=
LDAP_ATTR_NAME=displayName
LDAP_ATTR_MAIL=mail
LDAP_ANALYST_GROUP=
LDAP_ADMIN_GROUP=
# true: quem esta num grupo dentro desses grupos tambem ganha o papel
LDAP_NESTED_GROUPS=false
# Validade da senha em dias (admins nao expiram). 0 = sem validade
PASSWORD_MAX_AGE_DAYS=90
# Reputacao externa: consulta automatica no envio, so com o indicador (SHA-256 do arquivo;
# dominio ou IP do link). Deixe vazio para desligar cada servico.
VT_API_KEY=
# Uma chave da abuse.ch (auth.abuse.ch) serve para MalwareBazaar, URLhaus e ThreatFox
ABUSECH_AUTH_KEY=
ABUSEIPDB_API_KEY=
# Enriquecimento de links (so o dominio ou o IP sai, nunca a URL): quando o dominio foi registrado
# (RDAP, consultado direto no registro do TLD) e quando o host ganhou o primeiro certificado
# (Certificate Transparency, pelo crt.sh). Nao pedem chave, entao ficam desligados ate voce ligar.
RDAP_ENABLED=false
CT_ENABLED=false
# Para que IPs o dominio apontou (resolucoes do VirusTotal; usa a VT_API_KEY e a mesma cota).
PASSIVE_DNS_ENABLED=true
# Antivirus ClamAV (servico clamav do docker-compose). Deixe CLAMAV_HOST= vazio para desligar
# (o servico clamav pode ser removido do compose nesse caso).
CLAMAV_HOST=clamav
# Imagem do ClamAV (fixada por digest no docker-compose.yml); so troque para testar outra.
# CLAMAV_IMAGE=
CLAMAV_PORT=3310
# Captura da pagina de um link (servico capture do docker-compose: navegador isolado, sem
# acesso a rede interna). Deixe CAPTURE_URL= vazio para desligar. Troque o token (16+).
CAPTURE_URL=http://capture:3100
CAPTURE_TOKEN=troque-este-token-da-captura
# Sandbox do proprio Chromium (item 6.16); false so como saida de emergencia num host sem
# user namespaces. Um container novo a cada captura (item 6.17); false = processo de longa vida.
# CAPTURE_CHROMIUM_SANDBOX=true
# CAPTURE_RECYCLE=true
# Analise de funcoes (servico capa do docker-compose: capa e FLOSS, sem rede). Roda sozinha
# depois do envio de executaveis do Windows e do Linux, um por vez. Deixe CAPA_URL= vazio para
# desligar. Troque o token (16+).
CAPA_URL=http://capa:3200
CAPA_TOKEN=troque-este-token-do-capa
# Teto do arquivo (MB), tempo maximo de cada ferramenta (s), memoria do container e um container
# novo a cada analise (false = processo de longa vida).
# CAPA_MAX_MB=32
# CAPA_TIMEOUT_S=600
# FLOSS_TIMEOUT_S=300
# Quanto a API espera por uma analise (s). Subiu os dois tetos acima? Suba este tambem: precisa
# ficar acima da soma deles, senao a API desiste antes do servico.
# CAPA_REQUEST_TIMEOUT_S=1000
# CAPA_MEM_LIMIT=3g
# CAPA_RECYCLE=true
# Analise com o Ghidra (servico ghidra do docker-compose: sem rede), sob demanda: um analista pede
# na ficha. Deixe GHIDRA_URL= vazio para desligar. Troque o token (16+).
GHIDRA_URL=http://ghidra:3300
GHIDRA_TOKEN=troque-este-token-do-ghidra
# Teto do arquivo (MB), tempo maximo (s), heap do Java, memoria do container e um container novo a
# cada analise.
# GHIDRA_MAX_MB=32
# GHIDRA_TIMEOUT_S=900
# Espera da API (s): acima do GHIDRA_TIMEOUT_S, com folga para empacotar o projeto.
# GHIDRA_REQUEST_TIMEOUT_S=1300
# GHIDRA_HEADLESS_MAXMEM=3G
# GHIDRA_MEM_LIMIT=6g
# GHIDRA_RECYCLE=true
# Identificar e desempacotar (servico unpack do docker-compose: sem rede). Roda sozinho na chegada de
# todo executavel: o Detect It Easy identifica, e cada arquivo extraido de um empacotado ou
# instalador vira uma amostra filha. Deixe UNPACK_URL= vazio para desligar. Troque o token (16+).
UNPACK_URL=http://unpack:3400
UNPACK_TOKEN=troque-este-token-do-unpack
# Teto da amostra (MB), tempo maximo (s), arquivos e MB que saem de uma amostra, memoria e um
# container novo a cada trabalho.
# UNPACK_MAX_MB=64
# UNPACK_TIMEOUT_S=180
# Espera da API (s): acima do UNPACK_TIMEOUT_S.
# UNPACK_REQUEST_TIMEOUT_S=400
# UNPACK_MAX_FILES=50        (de 1 a 100: e o maximo que a API aceita numa resposta)
# UNPACK_MAX_TOTAL_MB=256
# UNPACK_MEM_LIMIT=2g
# UNPACK_RECYCLE=true
# Coloque true quando estiver servindo somente em HTTPS (Cloudflare Tunnel). Ligado, o cookie
# da sessao passa a se chamar __Host-dl_session: quem estava logado entra de novo uma vez.
COOKIE_SECURE=false
# Office e PDF mais fundo (servico oletools do docker-compose: olevba, MacroRaptor, msodde, oleid e
# rtfobj, sem rede; nenhuma macro e executada). Analisa sozinho cada documento do Office ou RTF
# enviado. Deixe OLETOOLS_URL= vazio para desligar. Troque o token (16+ caracteres).
OLETOOLS_URL=http://oletools:3500
OLETOOLS_TOKEN=troque-este-token-do-oletools
# OLETOOLS_MAX_MB=32
# OLETOOLS_TIMEOUT_S=120
# OLETOOLS_MEM_LIMIT=1g

# Sub-rede fixa da rede interna "deeplook": e a unica de onde a API aceita conexao e o
# X-Forwarded-For (o navegador da captura fica de fora). Troque so se colidir com outra rede
# do host; mudar exige `docker compose down` antes do `up`, para recriar a rede.
DEEPLOOK_SUBNET=172.31.250.0/24
# De onde o nginx aceita o IP real do visitante (cabecalho CF-Connecting-IP), alem do loopback: o
# gateway da rede acima (o primeiro endereco dela), que e como o cloudflared do host chega pela
# porta publicada. Trocou DEEPLOOK_SUBNET? Troque aqui tambem. Com o cloudflared em container,
# ponha o endereco (ou a faixa CIDR) dele.
# REAL_IP_FROM=172.31.250.1
# Sub-rede fixa da rede de saida da captura (o container egress). Serve para o host manda-la por
# uma VPN (roteamento por origem; docs/implantacao.md, passo 3). Mudar exige `docker compose down`.
CAPTURE_EGRESS_SUBNET=172.31.252.0/24

# ---- Admin semeado no primeiro boot ----
ADMIN_EMAIL=admin@deeplook.local
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Administrator

# ---- Uploads ----
MAX_UPLOAD_MB=200
# O envio vai para o disco (o /tmp da API) enquanto chega e so entra na memoria depois de inteiro,
# para a analise. Em memoria, os envios em analise somam ate MAX_UPLOAD_MEMORY_MB: o que passar
# espera a vez por ate 30 s e, se nao couber, recebe "tente de novo em instantes". Em disco, os
# que estao chegando somam ate MAX_UPLOAD_SPOOL_MB, e cada pessoa ocupa no maximo metade disso.
MAX_UPLOAD_MEMORY_MB=600
# MAX_UPLOAD_SPOOL_MB=2048
# Limite de memoria do container da API
API_MEM_LIMIT=4g
# Limite de processos e threads da API (os workers de analise contam; pico medido: 32)
# API_PIDS_LIMIT=256
# Envios por usuario comum nas ultimas 24 horas (0 desliga; analistas e admins sem limite).
UPLOAD_DAILY_LIMIT=20

# ---- MinIO / S3 ----
# Imagem do MinIO. Oficial (atual): quay.io/minio/minio:latest
# Alternativa no Docker Hub (espelho da comunidade): elestio/minio:latest
MINIO_IMAGE=pgsty/silo@sha256:7bb2aff6b89efe1cb1303c10fc21d579447434ed06649ac9ec05a5e2dbf30ad7
# A senha deste exemplo (ou a do compose, "deeplook123") tambem e recusada em producao.
MINIO_ROOT_USER=deeplook
MINIO_ROOT_PASSWORD=change-me-minio-password
# Porta (loopback) do console web do MinIO no host
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=deeplook
S3_SECRET_KEY=change-me-minio-password
S3_BUCKET=deeplook-samples
S3_FORCE_PATH_STYLE=true

# ---- Porta publicada no host (apontada pelo Cloudflare Tunnel) ----
WEB_PORT=8080
# Limite de memoria do container do web (nginx)
WEB_MEM_LIMIT=256m

# ---- Logs do Docker (rotacao, todos os servicos) ----
# Tamanho de cada arquivo de log e quantos ficam; sem limite o disco enche aos poucos.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ============================================================
# Sandbox de analise (VM isolada no Proxmox VE)
# ============================================================
# Deixe false para o stack funcionar sem Proxmox (feature inerte).
SANDBOX_ENABLED=false
# Mostra o console (noVNC) no painel do analista.
SANDBOX_CONSOLE_ENABLED=true
#
# PROXMOX_MOCK=true simula o Proxmox em memoria: da para desenvolver e
# testar todo o fluxo (provisionar, console, descartar) sem ter um PVE.
PROXMOX_MOCK=false
#
# ---- Conexao com o Proxmox VE ----
# URL da API do PVE (porta 8006). Ex.: https://192.168.0.10:8006
PROXMOX_API_URL=
# Node do cluster onde as VMs serao criadas. Ex.: pve
PROXMOX_NODE=pve
# Usuario dedicado (obrigatorio: o console NAO aceita API token, so ticket).
# Ex.: deeplook@pve
PROXMOX_USER=
PROXMOX_PASSWORD=
# VMID do template (com qemu-guest-agent e rede isolada).
PROXMOX_TEMPLATE_VMID=0
# Storage que aceita content "iso" (onde a amostra vira ISO read-only).
PROXMOX_ISO_STORAGE=local
# true apenas se o certificado do PVE for confiavel (senao deixe false).
PROXMOX_VERIFY_TLS=false
#
# ---- Politica das VMs ----
# Etiqueta usada para identificar/limpar VMs orfas criadas pelo DeepLook.
SANDBOX_TAG=deeplook-sandbox
# Tempo de vida da VM (minutos) antes do reaper destruir.
SANDBOX_TTL_MINUTES=60
# Maximo de VMs ativas no total e por analista.
SANDBOX_MAX_ACTIVE=4
SANDBOX_MAX_PER_USER=2
# Artefatos do ambiente: a cada N segundos, enquanto a VM roda, um print da tela e a lista de
# processos (pelo qemu-guest-agent). 0 desliga. Prints guardados por ambiente (o primeiro e os
# mais recentes).
# SANDBOX_ARTIFACT_INTERVAL_S=60
# SANDBOX_ARTIFACT_MAX_SHOTS=60
# No modo mock: URL ws:// de um VNC de teste (opcional) para validar o console.
SANDBOX_MOCK_VNC_URL=
